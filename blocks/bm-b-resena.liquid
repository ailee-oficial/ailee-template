{%- comment -%}
  Bloque «Reseña». Cada tarjeta declara su origen: real importada o real propia (puede mostrar nombre, ciudad y
  estrellas) o recreación IA (aviso visible en la tarjeta; nunca nombre, ciudad ni compra verificada). La disposición
  (lista, carrusel, cuadrícula o chat) sale de la sección. Regla: _nucleo/landing-formatos.md.
  Fuente canónica: claude-skills/core/tema_landing (kit v2: un theme block por tipo, blocks/bm-b-*).
{%- endcomment -%}
{%- assign disposicion = section.settings.disposicion -%}
{%- assign b = block.settings -%}
{%- assign es_ia = false -%}
{%- if b.origen == 'ia_recreada' -%}{%- assign es_ia = true -%}{%- endif -%}
<article class="bm-resena" data-bm-bloque="resena" data-origen="{{ b.origen }}" {{ block.shopify_attributes }}>
  {%- if disposicion == 'chat' -%}
    <div class="bm-chat__estado" aria-hidden="true"><span>9:41</span><span>▮▮▮ ◉ ▰</span></div>
  {%- endif -%}
  <div class="bm-resena__cabecera">
    {%- if disposicion == 'chat' -%}<span class="bm-chat__volver" aria-hidden="true">‹</span>{%- endif -%}
    {%- if b.avatar != blank -%}
      <span class="bm-resena__avatar">{{ b.avatar | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', alt: '' }}</span>
    {%- elsif disposicion == 'chat' or es_ia -%}
      <span class="bm-resena__avatar bm-resena__avatar--icon" role="img" aria-label="Icono ilustrativo de persona">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.3-7 8-7s8 2.6 8 7"/></svg>
      </span>
    {%- endif -%}
    {%- if es_ia -%}{% if disposicion == 'chat' %}<span class="bm-resena__autor">Conversación</span>{% endif %}
    {%- elsif b.nombre != blank or b.detalle != blank -%}<span class="bm-resena__autor">{{ b.nombre | escape }}{% if b.nombre != blank and b.detalle != blank %} · {% endif %}{{ b.detalle | escape }}</span>{%- endif -%}
    {%- if disposicion == 'chat' -%}<span class="bm-chat__llamada" aria-hidden="true">♧ ☎</span>{%- endif -%}
  </div>
  {%- if disposicion == 'chat' -%}<div class="bm-chat__mensajes"><span class="bm-chat__dia">HOY</span>{%- endif -%}
  {%- if b.estrellas > 0 -%}
    <div class="bm-resena__estrellas" role="img" aria-label="{% if es_ia %}Calificación ilustrativa generada con IA: {% endif %}{{ b.estrellas }} de 5">{% for i in (1..b.estrellas) %}★{% endfor %}</div>
  {%- endif -%}
  {%- if b.titulo != blank -%}<h3 class="bm-resena__titulo">{{ b.titulo | escape }}</h3>{%- endif -%}
  {%- if disposicion == 'chat' and b.apertura_tienda != blank -%}
    <p class="bm-resena__respuesta"><span class="bm-resena__respuesta-autor">La tienda</span>{{ b.apertura_tienda | escape }}</p>
  {%- endif -%}
  {%- if b.texto != blank -%}<p class="bm-resena__texto">{{ b.texto | escape }}</p>{%- endif -%}
  {%- if b.foto != blank -%}
    <a class="bm-resena__foto bm-resena__ampliar" href="{{ b.foto | image_url: width: 1600 }}" target="_blank" rel="noopener" aria-label="Ampliar foto de la reseña">{{ b.foto | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 380px, 84vw', widths: '360, 540, 720, 900', alt: b.foto_alt }}</a>
  {%- endif -%}
  {%- if disposicion == 'chat' and b.segundo_mensaje != blank -%}
    <p class="bm-resena__texto">{{ b.segundo_mensaje | escape }}</p>
  {%- endif -%}
  {%- if disposicion == 'chat' and b.respuesta_tienda != blank -%}
    <p class="bm-resena__respuesta"><span class="bm-resena__respuesta-autor">La tienda</span>{{ b.respuesta_tienda | escape }}</p>
  {%- endif -%}
  {%- if disposicion == 'chat' -%}
    </div><div class="bm-chat__entrada" aria-hidden="true"><span>＋</span><span class="bm-chat__campo"></span><span>◎</span><span class="bm-chat__micro">●</span></div>
  {%- endif -%}
  {%- if es_ia -%}
    <p class="bm-resena__etiqueta">{{ b.etiqueta | default: 'Recreación con IA · no es la reseña de un comprador' | escape }}</p>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Reseña",
  "tag": null,
  "settings": [
    {"type": "select", "id": "origen", "label": "Origen", "options": [{"value": "real_importada", "label": "Real importada (con fuente registrada)"}, {"value": "real_propia", "label": "Real de un cliente nuestro"}, {"value": "ia_recreada", "label": "Recreación generada con IA"}], "default": "ia_recreada", "info": "Las fotos y estrellas IA son ilustrativas y muestran aviso visible; sin nombre ni compra verificada."},
    {"type": "image_picker", "id": "foto", "label": "Foto o captura"},
    {"type": "image_picker", "id": "avatar", "label": "Foto pequeña de persona (real con permiso o sintética con origen IA)"},
    {"type": "text", "id": "foto_alt", "label": "Descripción de la foto"},
    {"type": "textarea", "id": "prompt", "label": "Prompt del texto IA (registro interno)"},
    {"type": "select", "id": "foto_origen", "label": "Procedencia de la foto", "options": [{"value": "ia_generada", "label": "Generada con IA"}, {"value": "reutilizada", "label": "Material existente del producto"}], "default": "ia_generada"},
    {"type": "textarea", "id": "foto_prompt", "label": "Prompt de la foto IA (registro interno)"},
    {"type": "textarea", "id": "avatar_prompt", "label": "Prompt del avatar IA (registro interno)"},
    {"type": "text", "id": "titulo", "label": "Título de la reseña"},
    {"type": "textarea", "id": "apertura_tienda", "label": "Primer mensaje de la tienda (solo chat)"},
    {"type": "textarea", "id": "texto", "label": "Texto"},
    {"type": "textarea", "id": "segundo_mensaje", "label": "Segundo mensaje de la persona (solo chat)"},
    {"type": "textarea", "id": "respuesta_tienda", "label": "Respuesta de la tienda (solo chat)", "info": "Si la conversación es real, transcribir la respuesta real; si es IA, usar solo datos comprobados de la oferta."},
    {"type": "text", "id": "nombre", "label": "Nombre (solo reseñas reales)"},
    {"type": "text", "id": "detalle", "label": "Ciudad o detalle (solo reseñas reales)"},
    {"type": "range", "id": "estrellas", "label": "Estrellas (ilustrativas si origen IA)", "min": 0, "max": 5, "step": 1, "default": 0},
    {"type": "url", "id": "fuente", "label": "Fuente de la reseña real (no se muestra)"},
    {"type": "text", "id": "etiqueta", "label": "Aviso de la recreación IA", "default": "Recreación con IA · no es la reseña de un comprador"}
  ],
  "presets": [{"name": "Reseña"}]
}
{% endschema %}
