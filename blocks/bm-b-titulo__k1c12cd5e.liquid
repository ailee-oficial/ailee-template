{%- comment -%} BM-KIT-COPIA blocks/bm-b-titulo.liquid k1c12cd5e: copia inmutable del kit para las páginas que la nombran; nunca se edita en el tema (otra versión es otro archivo). {%- endcomment -%}
{%- comment -%}
  Bloque «Título»: con estilo «Del producto», el encabezado de la primera pantalla (antetítulo, título y
  subtítulo; vacío = el nombre del producto); con «De la sección», el titular de una escena o del cierre. Con «Remate»
  lo pinta el encabezado del sistema visual (BM-CABEZA-V1, snippets/bm-v2-cabeza).
  Fuente canónica: claude-skills/core/tema_landing (kit v2: un theme block por tipo, blocks/bm-b-*).
{%- endcomment -%}
{%- assign product = closest.product | default: product -%}
{%- assign b = block.settings -%}
{%- assign texto = b.texto | default: product.title -%}
{%- if b.remate != blank -%}
  {%- comment -%} BM-CABEZA-V1: con remate, el encabezado del sistema visual (snippets/bm-v2-cabeza), el mismo de toda sección v2. {%- endcomment -%}
  {%- assign clase = 'bm-v2-titulo' -%}
  {%- if b.estilo == 'producto' -%}{%- assign clase = 'bm-oferta__encabezado' -%}{%- endif -%}
  {%- capture attrs -%}data-bm-bloque="titulo" {{ block.shopify_attributes }}{%- endcapture -%}
  {%- render 'bm-v2-cabeza', antetitulo: b.antetitulo, titulo: texto, remate: b.remate, subtitulo: b.subtitulo, nivel: b.nivel, tam: b.tamano, clase: clase, attrs: attrs -%}
{%- elsif b.estilo == 'producto' -%}
  <div class="bm-oferta__encabezado" data-bm-bloque="titulo" {{ block.shopify_attributes }}>
    {%- if b.antetitulo != blank -%}<p class="bm-oferta__ante">{{ b.antetitulo | escape }}</p>{%- endif -%}
    {%- case b.nivel -%}
      {%- when 'h1' -%}<h1 class="bm-oferta__titulo" style="--bm-titulo-tam:{{ b.tamano }}px">{{ texto | escape }}</h1>
      {%- when 'h3' -%}<h3 class="bm-oferta__titulo" style="--bm-titulo-tam:{{ b.tamano }}px">{{ texto | escape }}</h3>
      {%- else -%}<h2 class="bm-oferta__titulo" style="--bm-titulo-tam:{{ b.tamano }}px">{{ texto | escape }}</h2>
    {%- endcase -%}
    {%- if b.subtitulo != blank -%}<p class="bm-oferta__sub">{{ b.subtitulo | escape }}</p>{%- endif -%}
  </div>
{%- else -%}
  <div class="bm-v2-titulo" data-bm-bloque="titulo" {{ block.shopify_attributes }}>
    {%- if b.antetitulo != blank -%}<p class="bm-oferta__ante">{{ b.antetitulo | escape }}</p>{%- endif -%}
    {%- case b.nivel -%}
      {%- when 'h1' -%}<h1 class="bm-titulo" style="--bm-titulo-tam:{{ b.tamano }}px">{{ texto | escape }}</h1>
      {%- when 'h3' -%}<h3 class="bm-titulo" style="--bm-titulo-tam:{{ b.tamano }}px">{{ texto | escape }}</h3>
      {%- else -%}<h2 class="bm-titulo" style="--bm-titulo-tam:{{ b.tamano }}px">{{ texto | escape }}</h2>
    {%- endcase -%}
    {%- if b.subtitulo != blank -%}<p class="bm-v2-subtitulo">{{ b.subtitulo | escape }}</p>{%- endif -%}
  </div>
{%- endif -%}

<style data-bm-kit="k1c12cd5e">
.bm-v2-titulo>*{margin:0}
.bm-v2-titulo>*+*{margin-top:6px}
.bm-v2-subtitulo{line-height:1.4;opacity:.85}
</style>

{% schema %}
{
  "name": "Título",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "estilo",
      "label": "Estilo",
      "options": [
        {
          "value": "seccion",
          "label": "De la sección (escena, cierre)"
        },
        {
          "value": "producto",
          "label": "Del producto (primera pantalla)"
        }
      ],
      "default": "seccion"
    },
    {
      "type": "text",
      "id": "antetitulo",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "texto",
      "label": "Título",
      "info": "Vacío: el nombre del producto."
    },
    {
      "type": "text",
      "id": "remate",
      "label": "Remate (segunda línea, en cursiva)",
      "info": "Enciende el encabezado del sistema visual: el antetítulo pasa a etiqueta en píldora y el remate va en cursiva del color de acento. Vacío: el título de siempre."
    },
    {
      "type": "select",
      "id": "nivel",
      "label": "Nivel",
      "options": [
        {
          "value": "h1",
          "label": "H1 (solo la primera pantalla)"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "tamano",
      "label": "Tamaño",
      "min": 18,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "textarea",
      "id": "subtitulo",
      "label": "Subtítulo"
    }
  ]
}
{% endschema %}
