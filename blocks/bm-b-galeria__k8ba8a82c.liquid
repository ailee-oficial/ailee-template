      }, { passive: true });
      this.querySelectorAll('[data-bm-paso]').forEach((b) => this.escuchar(b, 'click', () => this.ir(this.i + Number(b.dataset.bmPaso))));
      this.minis.forEach((m) => this.escuchar(m, 'click', () => this.ir(Number(m.dataset.bmIr) - 1)));
      this.alVariar((v, origen) => { if (origen !== 'galeria') this.mostrar(v, true); });
      const inicio = Math.max(0, Number(this.dataset.inicio || 1) - 1);
      this.ir(inicio, false);
      const v = this.p && actual(this.p);
      if (v) this.mostrar(v, false);
      this.mirar(false);
      this.portada();
    }
    // BM-PORTADA-V1: historias (avanza sola dentro del color que se ve), viva (luces) y flotante (discos).
