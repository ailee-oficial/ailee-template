{%- comment -%}
  Bloque «Elemento» de «Beneficios»: ícono, símbolo o número, título y texto. Con «Numerar» en la sección, el
  número sale del orden (contador CSS), así se puede reordenar sin renumerar.
  Fuente canónica: claude-skills/core/tema_landing (kit v2: un theme block por tipo, blocks/bm-b-*).
{%- endcomment -%}
{%- assign b = block.settings -%}
<div class="bm-item" data-bm-bloque="item" {{ block.shopify_attributes }}>
  {%- if b.icono != blank -%}
    <div class="bm-item__icono">{{ b.icono | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', alt: '' }}</div>
  {%- elsif b.simbolo != blank -%}
    <span class="bm-item__simbolo" aria-hidden="true">{{ b.simbolo | escape }}</span>
  {%- elsif section.settings.numerar -%}
    <span class="bm-item__simbolo bm-v2-numero" aria-hidden="true"></span>
  {%- endif -%}
  <div>
    {%- if b.titulo != blank -%}<p class="bm-item__titulo">{{ b.titulo | escape }}</p>{%- endif -%}
    {%- if b.texto != blank -%}<p class="bm-item__texto">{{ b.texto | escape }}</p>{%- endif -%}
  </div>
</div>

{% stylesheet %}
.bm-items__grid{counter-reset:bm-paso}
.bm-item{counter-increment:bm-paso}
.bm-v2-numero::before{content:counter(bm-paso)}
{% endstylesheet %}

{% schema %}
{
  "name": "Elemento",
  "tag": null,
  "settings": [
    {"type": "image_picker", "id": "icono", "label": "Icono o foto pequeña"},
    {"type": "text", "id": "simbolo", "label": "Símbolo o número (si no hay icono)"},
    {"type": "text", "id": "titulo", "label": "Título", "default": "Beneficio"},
    {"type": "textarea", "id": "texto", "label": "Texto", "default": "Qué cambia para el cliente."}
  ],
  "presets": [{"name": "Elemento"}]
}
{% endschema %}
