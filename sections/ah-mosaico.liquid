{{ 'ah-home.css' | asset_url | stylesheet_tag }}
{%- comment -%} Mosaico de fotos a todo el ancho con una frase encima de cada una (texto HTML, no horneado). {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .ah-mosaico { --ah-cols: {{ section.blocks.size }}; }
{%- endstyle -%}
<section class="ah">
  {%- if section.settings.titulo != blank -%}
    <div class="ah-mosaico__cabecera">
      {%- if section.settings.eyebrow != blank -%}<p class="ah-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ah-titulo">{{ section.settings.titulo | escape }}</h2>
    </div>
  {%- endif -%}
  <div class="ah-mosaico ah-mosaico--{{ section.settings.posicion_texto }}">
    {%- for block in section.blocks -%}
      {%- if block.settings.enlace != blank -%}<a class="ah-mosaico__pieza" href="{{ block.settings.enlace }}" {{ block.shopify_attributes }}>{%- else -%}<div class="ah-mosaico__pieza" {{ block.shopify_attributes }}>{%- endif -%}
        {%- render 'ah-img', imagen: block.settings.imagen, respaldo: block.settings.respaldo, alt: block.settings.texto, sizes: '(min-width: 750px) 25vw, 50vw', ancho: 1080, alto: 1440 -%}
        <p class="ah-mosaico__texto">{{ block.settings.texto | escape | newline_to_br }}</p>
      {%- if block.settings.enlace != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>
<style>
  .ah-mosaico { display: grid; grid-template-columns: repeat(var(--ah-cols, 4), minmax(0, 1fr)); gap: 4px; }
  .ah-mosaico__cabecera { padding: 40px 20px 18px; text-align: center; }
  .ah-mosaico__pieza { display: block; text-decoration: none; position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: var(--ah-sand); }
  .ah-mosaico__pieza img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ah-mosaico__texto { position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: 40px 12px 16px; text-align: center;
    font-family: var(--ah-serif) !important; font-size: clamp(18px, 1.7vw, 24px); line-height: 1.15; color: var(--ah-ink);
    background: linear-gradient(0deg, rgba(250,247,244,.92) 0%, rgba(250,247,244,.75) 55%, rgba(250,247,244,0) 100%); }
  /* Frase arriba: el producto suele estar abajo en la foto (los zapatos) y no se tapa */
  .ah-mosaico--arriba .ah-mosaico__texto { top: 0; bottom: auto; padding: 14px 12px 40px;
    background: linear-gradient(180deg, rgba(250,247,244,.92) 0%, rgba(250,247,244,.7) 55%, rgba(250,247,244,0) 100%); }
  @media (max-width: 749px) {
    .ah-mosaico { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ah-mosaico--arriba .ah-mosaico__texto { padding: 10px 8px 30px; }
    .ah-mosaico__texto { font-size: 17px; padding: 30px 8px 12px; }
  }
</style>

{% schema %}
{
  "name": "Ailee · Mosaico",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo (opcional)" },
    { "type": "text", "id": "titulo", "label": "Título (opcional)" },
    { "type": "select", "id": "posicion_texto", "label": "Frase sobre la foto", "default": "arriba",
      "options": [{ "value": "arriba", "label": "Arriba (no tapa el producto)" }, { "value": "abajo", "label": "Abajo" }] }
  ],
  "blocks": [
    {
      "type": "pieza",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen", "info": "Vertical 3:4." },
        { "type": "text", "id": "respaldo", "label": "Imagen provisional del tema" },
        { "type": "textarea", "id": "texto", "label": "Frase", "default": "Combina\ncon todo" },
        { "type": "text", "id": "enlace", "label": "Enlace (opcional)", "info": "Escribe #comprar para bajar a la ficha de compra." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Ailee · Mosaico", "blocks": [{ "type": "pieza" }, { "type": "pieza" }, { "type": "pieza" }, { "type": "pieza" }] }]
}
{% endschema %}
