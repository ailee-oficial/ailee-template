{%- comment -%}
  Escena de la landing «imágenes + HTML»: una imagen de dirección de arte y un panel HTML editable
  (título, texto, lista, precio real del producto, botón de compra). La disposición, los colores y
  el espacio interno se cambian desde el editor sin regenerar la imagen.
  Fuente canónica: claude-skills/core/tema_landing.
{%- endcomment -%}
{{ 'bm-landing.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- if s.prioridad -%}
  {%- assign carga = 'eager' -%}
  {%- assign prioridad = 'high' -%}
{%- else -%}
  {%- assign carga = 'lazy' -%}
  {%- assign prioridad = 'auto' -%}
{%- endif -%}
<div class="bm-sec bm-escena-sec{% if s.ancho == 'completo' %} bm-sec--completo{% endif %}" data-bm-landing="escena" data-bm-sec="{{ section.id }}" style="{% if s.fondo != blank %}--bm-sec-bg:{{ s.fondo }};{% endif %}{% if s.texto != blank %}--bm-sec-fg:{{ s.texto }};{% endif %}{% if s.panel_fondo != blank %}--bm-panel-bg:{{ s.panel_fondo }};{% endif %}{% if s.acento != blank %}--bm-acento:{{ s.acento }};{% endif %}{% if s.acento_texto != blank %}--bm-acento-fg:{{ s.acento_texto }};{% endif %}--bm-pad-top:{{ s.padding_top }}px;--bm-pad-bottom:{{ s.padding_bottom }}px;--bm-panel-pad:{{ s.panel_padding }}px;--bm-panel-gap:{{ s.separacion }}px;--bm-align:{{ s.alineacion }};--bm-precio-align:{% if s.alineacion == 'center' %}center{% elsif s.alineacion == 'right' %}flex-end{% else %}flex-start{% endif %};--bm-panel-v:{{ s.posicion_texto }};{% unless s.sobre_degradado %}--bm-panel-sobre:transparent;{% endunless %}">
  <div class="bm-sec__in">
    <div class="bm-escena bm-escena--{{ s.disposicion }}">
      {%- if s.titulo_oculto != blank -%}
        {%- if s.nivel_oculto == 'h1' -%}
          <h1 class="bm-sr">{{ s.titulo_oculto | escape }}</h1>
        {%- else -%}
          <h2 class="bm-sr">{{ s.titulo_oculto | escape }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if s.imagen != blank -%}
        <div class="bm-escena__media">
          <picture>
            {%- if s.imagen_escritorio != blank -%}
              <source media="(min-width: 750px)" srcset="{{ s.imagen_escritorio | image_url: width: 1600 }}">
            {%- endif -%}
            {{ s.imagen | image_url: width: 1600 | image_tag: loading: carga, fetchpriority: prioridad, sizes: '(min-width: 750px) 780px, 100vw', widths: '360, 540, 720, 900, 1080, 1280, 1600', alt: s.texto_alt }}
          </picture>
        </div>
      {%- elsif request.design_mode and s.disposicion != 'solo_texto' -%}
        <div class="bm-escena__media">{{ 'image' | placeholder_svg_tag: 'bm-placeholder' }}</div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="bm-escena__panel">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- case block.type -%}
              {%- when 'titulo' -%}
                {%- if b.nivel == 'h1' -%}
                  <h1 class="bm-titulo" style="--bm-titulo-tam:{{ b.tamano }}px" data-bm-bloque="titulo" {{ block.shopify_attributes }}>{{ b.texto | escape }}</h1>
                {%- elsif b.nivel == 'h3' -%}
                  <h3 class="bm-titulo" style="--bm-titulo-tam:{{ b.tamano }}px" data-bm-bloque="titulo" {{ block.shopify_attributes }}>{{ b.texto | escape }}</h3>
                {%- else -%}
                  <h2 class="bm-titulo" style="--bm-titulo-tam:{{ b.tamano }}px" data-bm-bloque="titulo" {{ block.shopify_attributes }}>{{ b.texto | escape }}</h2>
                {%- endif -%}
              {%- when 'texto' -%}
                <div class="bm-texto" data-bm-bloque="texto" {{ block.shopify_attributes }}>{{ b.texto }}</div>
              {%- when 'lista' -%}
                {%- assign lineas = b.items | newline_to_br | split: '<br />' -%}
                <ul class="bm-lista" data-bm-bloque="lista" {{ block.shopify_attributes }}>
                  {%- for linea in lineas -%}
                    {%- assign item = linea | strip -%}
                    {%- if item != blank -%}
                      <li><span class="bm-lista__icono" aria-hidden="true">{{ b.icono | default: '✓' | escape }}</span><span>{{ item | escape }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- when 'insignia' -%}
                <p data-bm-bloque="insignia" {{ block.shopify_attributes }}><span class="bm-insignia">{{ b.texto | escape }}</span></p>
              {%- when 'precio' -%}
                {%- if product != blank -%}
                  {%- assign variante = product.selected_or_first_available_variant -%}
                  <div class="bm-precio" data-bm-bloque="precio" {{ block.shopify_attributes }}>
                    {%- if b.prefijo != blank -%}<span class="bm-precio__prefijo">{{ b.prefijo | escape }}</span>{%- endif -%}
                    <span class="bm-precio__actual">{{ variante.price | money }}</span>
                    {%- if variante.compare_at_price > variante.price -%}
                      <s class="bm-precio__antes">{{ variante.compare_at_price | money }}</s>
                      {%- if b.mostrar_ahorro -%}
                        {%- assign ahorro = variante.compare_at_price | minus: variante.price | times: 100 | divided_by: variante.compare_at_price -%}
                        <span class="bm-precio__ahorro">-{{ ahorro }}%</span>
                      {%- endif -%}
                    {%- endif -%}
                    {%- if b.nota != blank -%}<span class="bm-precio__nota">{{ b.nota | escape }}</span>{%- endif -%}
                  </div>
                {%- endif -%}
              {%- when 'cta' -%}
                <div data-bm-bloque="cta" {{ block.shopify_attributes }}>
                  {%- render 'bm-cta', texto: b.texto, subtexto: b.subtexto, fondo: b.fondo, color: b.color, franja: blank, ancho: b.ancho, alineacion: b.alineacion, pad_y: b.pad_y, pulso: b.pulso -%}
                </div>
              {%- when 'etiqueta_ia' -%}
                <p class="bm-nota bm-nota--ia" data-bm-bloque="etiqueta_ia" data-origen="ia_recreada" {{ block.shopify_attributes }}>{{ b.texto | default: 'Recreación ilustrativa generada con IA; no es la reseña de un comprador.' | escape }}</p>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Landing · Escena + texto",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen (móvil y escritorio)" },
    { "type": "image_picker", "id": "imagen_escritorio", "label": "Imagen solo para escritorio (opcional)" },
    { "type": "textarea", "id": "texto_alt", "label": "Texto integrado en la imagen", "info": "Texto alternativo: copia lo que se lee en la imagen." },
    { "type": "text", "id": "titulo_oculto", "label": "Título para buscadores (no visible)", "info": "Úsalo cuando el titular ya está dibujado en la imagen, para no repetirlo visible." },
    { "type": "select", "id": "nivel_oculto", "label": "Nivel del título oculto", "options": [
      { "value": "h1", "label": "H1 (solo la primera pantalla)" },
      { "value": "h2", "label": "H2" }
    ], "default": "h2" },
    { "type": "checkbox", "id": "prioridad", "label": "Es la primera pantalla (carga prioritaria)", "default": false },
    { "type": "header", "content": "Disposición" },
    { "type": "select", "id": "disposicion", "label": "Disposición", "options": [
      { "value": "imagen_arriba", "label": "Imagen arriba, texto debajo" },
      { "value": "texto_arriba", "label": "Texto arriba, imagen debajo" },
      { "value": "texto_sobre", "label": "Texto sobre la imagen" },
      { "value": "lado", "label": "Lado a lado en escritorio" },
      { "value": "solo_texto", "label": "Solo texto" }
    ], "default": "imagen_arriba" },
    { "type": "select", "id": "posicion_texto", "label": "Posición del texto sobre la imagen", "options": [
      { "value": "start", "label": "Arriba" },
      { "value": "center", "label": "Centro" },
      { "value": "end", "label": "Abajo" }
    ], "default": "end" },
    { "type": "checkbox", "id": "sobre_degradado", "label": "Degradado detrás del texto sobre la imagen", "default": true },
    { "type": "select", "id": "alineacion", "label": "Alineación del texto", "options": [
      { "value": "left", "label": "Izquierda" },
      { "value": "center", "label": "Centro" },
      { "value": "right", "label": "Derecha" }
    ], "default": "left" },
    { "type": "select", "id": "ancho", "label": "Ancho en escritorio", "options": [
      { "value": "contenido", "label": "Ancho del contenido" },
      { "value": "completo", "label": "Pantalla completa" }
    ], "default": "contenido" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "fondo", "label": "Fondo de la sección", "info": "Vacío: el de la página." },
    { "type": "color", "id": "panel_fondo", "label": "Fondo del panel de texto", "info": "Vacío: transparente." },
    { "type": "color", "id": "texto", "label": "Color del texto", "info": "Vacío: el de la página." },
    { "type": "color", "id": "acento", "label": "Acento (iconos, insignias, ahorro)" },
    { "type": "color", "id": "acento_texto", "label": "Texto sobre el acento" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "panel_padding", "label": "Espacio interno del panel", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "separacion", "label": "Separación entre elementos del panel", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "padding_top", "label": "Espacio superior de la sección", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior de la sección", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "titulo", "name": "Título", "settings": [
      { "type": "text", "id": "texto", "label": "Texto", "default": "Titular del bloque" },
      { "type": "select", "id": "nivel", "label": "Nivel", "options": [
        { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }
      ], "default": "h2" },
      { "type": "range", "id": "tamano", "label": "Tamaño", "min": 18, "max": 44, "step": 2, "unit": "px", "default": 26 }
    ] },
    { "type": "texto", "name": "Texto", "settings": [
      { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Explica aquí el beneficio con las palabras del cliente.</p>" }
    ] },
    { "type": "lista", "name": "Lista", "settings": [
      { "type": "textarea", "id": "items", "label": "Elementos (uno por línea)", "default": "Primer beneficio\nSegundo beneficio" },
      { "type": "text", "id": "icono", "label": "Símbolo", "default": "✓" }
    ] },
    { "type": "insignia", "name": "Insignia", "settings": [
      { "type": "text", "id": "texto", "label": "Texto", "default": "Pago contra entrega" }
    ] },
    { "type": "precio", "name": "Precio del producto", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Muestra el precio real de la variante: se cambia en el producto, no aquí." },
      { "type": "text", "id": "prefijo", "label": "Texto antes del precio", "default": "Hoy" },
      { "type": "checkbox", "id": "mostrar_ahorro", "label": "Mostrar % de ahorro si hay precio de comparación", "default": true },
      { "type": "text", "id": "nota", "label": "Nota bajo el precio", "default": "Pagas al recibir" }
    ] },
    { "type": "cta", "name": "Botón de compra", "settings": [
      { "type": "text", "id": "texto", "label": "Texto del botón", "default": "Pedir ahora · pago contra entrega" },
      { "type": "text", "id": "subtexto", "label": "Línea bajo el botón", "default": "Pagas al recibir" },
      { "type": "color", "id": "fondo", "label": "Fondo del botón", "info": "Vacío: el de «Landing · Ajustes y botón»." },
      { "type": "color", "id": "color", "label": "Texto del botón", "info": "Vacío: el de «Landing · Ajustes y botón»." },
      { "type": "select", "id": "ancho", "label": "Ancho", "options": [
        { "value": "completo", "label": "Completo" }, { "value": "auto", "label": "Según el texto" }
      ], "default": "completo" },
      { "type": "select", "id": "alineacion", "label": "Alineación", "options": [
        { "value": "center", "label": "Centro" }, { "value": "flex-start", "label": "Izquierda" }, { "value": "flex-end", "label": "Derecha" }
      ], "default": "center" },
      { "type": "range", "id": "pad_y", "label": "Espacio vertical alrededor", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
      { "type": "checkbox", "id": "pulso", "label": "Animación suave de pulso", "default": false }
    ] },
    { "type": "etiqueta_ia", "name": "Aviso de recreación IA", "settings": [
      { "type": "text", "id": "texto", "label": "Aviso", "default": "Recreación ilustrativa generada con IA; no es la reseña de un comprador." }
    ] }
  ],
  "presets": [{ "name": "Landing · Escena + texto", "blocks": [{ "type": "titulo" }, { "type": "texto" }, { "type": "cta" }] }]
}
{% endschema %}
