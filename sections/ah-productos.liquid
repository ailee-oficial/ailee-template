{%- comment -%}
  Sin colección elegida muestra el catálogo completo (collections.all): el home nunca queda vacío
  y en cuanto exista la colección «Best sellers» basta con escogerla en el editor.
{%- endcomment -%}
{%- assign ah_col = section.settings.coleccion -%}
{%- if ah_col == blank -%}{%- assign ah_col = collections.all -%}{%- endif -%}
{%- comment -%} Con menos productos que columnas, la grilla se ajusta para no dejar huecos. {%- endcomment -%}
{%- assign ah_cols = section.settings.columnas -%}
{%- assign ah_total = ah_col.products.size -%}
{%- if ah_total > section.settings.cantidad -%}{%- assign ah_total = section.settings.cantidad -%}{%- endif -%}
{%- if ah_total > 0 and ah_total < ah_cols -%}{%- assign ah_cols = ah_total -%}{%- endif -%}
{{ 'ah-home.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .ah-espacio { --ah-pt: {{ section.settings.pt }}px; --ah-pb: {{ section.settings.pb }}px; }
  #shopify-section-{{ section.id }} .ah-productos__grilla { --ah-cols: {{ ah_cols }}; }
{%- endstyle -%}
<section class="ah">
  <div class="ah-contenedor ah-espacio">
    <div class="ah-cabecera">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="ah-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="ah-titulo ah-titulo--recto">{{ section.settings.titulo | escape }}</h2>
      </div>
      {%- if section.settings.ver_todos != blank -%}
        <a class="ah-enlace" href="{{ ah_col.url | default: '/collections/all' }}">{{ section.settings.ver_todos | escape }} {%- render 'ah-icono', icono: 'flecha' -%}</a>
      {%- endif -%}
    </div>

    {%- if ah_col.products.size > 0 -%}
      <div class="ah-productos__grilla">
        {%- for product in ah_col.products -%}
          {%- if forloop.index <= section.settings.cantidad -%}
            <a class="ah-producto" href="{{ product.url }}">
              <div class="ah-producto__foto">
                {%- if product.compare_at_price > product.price -%}<span class="ah-producto__etiqueta">Oferta</span>{%- endif -%}
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 50vw', widths: '360, 540, 720, 900', alt: product.title }}
                  {%- if section.settings.segunda_foto and product.images.size > 1 -%}
                    {{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, 50vw', widths: '360, 540, 720, 900', alt: product.title }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <p class="ah-producto__nombre">{{ product.title | escape }}</p>
              <p class="ah-producto__precio">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}<span class="ah-producto__antes">{{ product.compare_at_price | money }}</span>{%- endif -%}
              </p>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ah-productos__vacio">Aquí aparecerán tus productos cuando la colección tenga artículos.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ailee · Productos",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Best sellers" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Lo que más aman" },
    { "type": "collection", "id": "coleccion", "label": "Colección", "info": "Si la dejas vacía se muestra todo el catálogo." },
    { "type": "range", "id": "cantidad", "label": "Cantidad de productos", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columnas", "label": "Columnas en escritorio", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "segunda_foto", "label": "Mostrar la segunda foto al pasar el mouse", "default": true },
    { "type": "text", "id": "ver_todos", "label": "Texto del enlace", "default": "Ver todos" },
    { "type": "range", "id": "pt", "label": "Espacio arriba", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb", "label": "Espacio abajo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Ailee · Productos" }]
}
{% endschema %}
