{%- comment -%}
  «Míralo en acción»: videos REALES del producto (proveedor, propios o de una referencia con
  permiso), verticales, en carrusel. Sin material real esta sección no se usa: no se paga IA de
  video para la landing (landing-formatos.md). Cada video se elige desde Archivos de Shopify o se
  pega la URL del MP4 hospedado en Archivos. Fuente canónica: claude-skills/core/tema_landing.
{%- endcomment -%}
{{ 'bm-landing.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<div class="bm-sec bm-videos" data-bm-landing="videos" data-bm-sec="{{ section.id }}" style="{% if s.fondo != blank %}--bm-sec-bg:{{ s.fondo }};{% endif %}{% if s.texto != blank %}--bm-sec-fg:{{ s.texto }};{% endif %}--bm-pad-top:{{ s.padding_top }}px;--bm-pad-bottom:{{ s.padding_bottom }}px;--bm-pad-x:{{ s.padding_lateral }}px;--bm-video-ancho:{{ s.ancho_tarjeta }}%;--bm-align:{{ s.alineacion }};">
  <div class="bm-sec__in">
    {%- if s.antetitulo != blank or s.titulo != blank or s.subtitulo != blank -%}
      <div class="bm-cabecera">
        {%- if s.antetitulo != blank -%}<p class="bm-oferta__ante">{{ s.antetitulo | escape }}</p>{%- endif -%}
        {%- if s.titulo != blank -%}<h2>{{ s.titulo | escape }}</h2>{%- endif -%}
        {%- if s.subtitulo != blank -%}<p>{{ s.subtitulo | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="bm-videos__lista">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="bm-videos__item" data-bm-bloque="video" {{ block.shopify_attributes }}>
          {%- if b.video != blank -%}
            {{ b.video | video_tag: image_size: '720x', autoplay: false, loop: true, muted: true, controls: true, class: 'bm-videos__v' }}
          {%- elsif b.video_url != blank -%}
            <video class="bm-videos__v" src="{{ b.video_url }}"{% if b.portada != blank %} poster="{{ b.portada | image_url: width: 720 }}"{% endif %} controls playsinline muted loop preload="metadata"></video>
          {%- elsif request.design_mode -%}
            {{ 'image' | placeholder_svg_tag: 'bm-placeholder' }}
          {%- endif -%}
          {%- if b.leyenda != blank -%}<figcaption>{{ b.leyenda | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.cta_mostrar -%}
    {%- render 'bm-cta', texto: s.cta_texto, subtexto: s.cta_subtexto, fondo: blank, color: blank, franja: blank, ancho: 'completo', alineacion: 'center', pad_y: 14, pulso: false -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Landing · Videos",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "Solo videos reales del producto. Sin material, no se usa esta sección." },
    { "type": "text", "id": "antetitulo", "label": "Antetítulo", "default": "En video" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Míralo en acción" },
    { "type": "text", "id": "subtitulo", "label": "Subtítulo" },
    { "type": "range", "id": "ancho_tarjeta", "label": "Ancho de cada video en el carrusel", "min": 40, "max": 90, "step": 5, "unit": "%", "default": 60 },
    { "type": "select", "id": "alineacion", "label": "Alineación del título", "options": [
      { "value": "center", "label": "Centro" }, { "value": "left", "label": "Izquierda" }
    ], "default": "center" },
    { "type": "color", "id": "fondo", "label": "Fondo", "info": "Vacío: el de la página." },
    { "type": "color", "id": "texto", "label": "Texto" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_lateral", "label": "Margen lateral", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "header", "content": "Botón de compra" },
    { "type": "checkbox", "id": "cta_mostrar", "label": "Mostrar botón al final", "default": true },
    { "type": "text", "id": "cta_texto", "label": "Texto del botón", "default": "Comprar ahora — Pago contra entrega" },
    { "type": "text", "id": "cta_subtexto", "label": "Línea bajo el botón" }
  ],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "video", "id": "video", "label": "Video (desde Archivos)" },
      { "type": "url", "id": "video_url", "label": "O URL del MP4 en Archivos" },
      { "type": "image_picker", "id": "portada", "label": "Portada (para la URL)" },
      { "type": "text", "id": "leyenda", "label": "Leyenda" }
    ] }
  ],
  "presets": [{ "name": "Landing · Videos", "blocks": [{ "type": "video" }, { "type": "video" }] }]
}
{% endschema %}
