{%- comment -%} BM-KIT-COPIA sections/bm-galeria-v2.liquid k7f1fc1c9: copia inmutable del kit para las páginas que la nombran; nunca se edita en el tema (otra versión es otro archivo). {%- endcomment -%}
{%- comment -%}
  Galería (kit v2): el producto puesto en varias ocasiones, clave cuando el eje es deseo; también capturas
  REALES de clientes. Carrusel o cuadrícula; cada foto con su etiqueta.
  Fuente canónica: claude-skills/core/tema_landing (kit v2: cada bloque es un theme block, blocks/bm-b-*).
{%- endcomment -%}
{%- render 'bm-v2-recursos__k65a02952' -%}
{%- assign s = section.settings -%}
<div class="bm-sec bm-galeria bm-v2 bm-galeria--{{ s.disposicion }}" data-bm-landing="galeria" data-bm-sec="{{ section.id }}" data-bm-segundos="{{ s.segundos | default: 2 }}" style="{% if s.fondo != blank %}--bm-sec-bg:{{ s.fondo }};{% endif %}{% if s.texto != blank %}--bm-sec-fg:{{ s.texto }};{% endif %}{% if s.cabeza_acento != blank %}--bm-cabeza-c:{{ s.cabeza_acento }};{% endif %}--bm-pad-top:{{ s.padding_top }}px;--bm-pad-bottom:{{ s.padding_bottom }}px;--bm-pad-x:{{ s.padding_lateral }}px;--bm-radio-img:{{ s.radio }}px;--bm-galeria-ancho:{{ s.ancho_tarjeta }}%;--bm-align:{{ s.alineacion }};">
  <div class="bm-sec__in">
    {%- render 'bm-v2-cabeza', antetitulo: s.antetitulo, titulo: s.titulo, remate: s.remate, subtitulo: s.subtitulo -%}
    <div class="bm-galeria__lista">
      {%- content_for 'blocks' -%}
    </div>
  </div>
  {%- if s.cta_mostrar -%}
    {%- render 'bm-cta__k9778c285', texto: s.cta_texto, subtexto: s.cta_subtexto, fondo: s.boton_fondo, color: s.boton_color, ancho: 'completo', alineacion: 'center', pad_y: 14, pulso: false -%}
  {%- endif -%}
  {%- if s.diferir -%}{%- render 'bm-diferir' -%}{%- endif -%}
</div>

{% schema %}
{
  "name": "Galería",
  "tag": "section",
  "class": "bm-v2-seccion",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "El producto en varias ocasiones, o capturas reales de clientes."
    },
    {
      "type": "text",
      "id": "antetitulo",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Para cada ocasión"
    },
    {
      "type": "text",
      "id": "remate",
      "label": "Remate (segunda línea, en cursiva)",
      "info": "Enciende el encabezado del sistema visual: etiqueta en píldora, título, remate en cursiva y bajada. Vacío: el encabezado de siempre."
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtítulo"
    },
    {
      "type": "select",
      "id": "disposicion",
      "label": "Disposición",
      "options": [
        {
          "value": "carrusel",
          "label": "Carrusel horizontal"
        },
        {
          "value": "cuadricula",
          "label": "Cuadrícula de 2"
        }
      ],
      "default": "carrusel"
    },
    {
      "type": "range",
      "id": "ancho_tarjeta",
      "label": "Ancho de cada foto en el carrusel",
      "min": 50,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "segundos",
      "label": "Segundos por tarjeta",
      "info": "El carrusel avanza solo y vuelve a empezar sin fin; cuánto se queda cada tarjeta antes de pasar a la siguiente.",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "unit": "s",
      "default": 2
    },
    {
      "type": "range",
      "id": "radio",
      "label": "Redondeo de las fotos",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "diferir",
      "label": "Cargar las fotos después del botón de compra",
      "info": "Las fotos bajan cuando la página terminó de cargar o cuando la clienta se acerca. Así no compiten con el botón ni con el pixel en redes lentas.",
      "default": false
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación del título",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "fondo",
      "label": "Fondo",
      "info": "Vacío: el de la página."
    },
    {
      "type": "color",
      "id": "texto",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "cabeza_acento",
      "label": "Color de la etiqueta y el remate",
      "info": "Vacío: el del texto."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_lateral",
      "label": "Margen lateral",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Botón de compra"
    },
    {
      "type": "checkbox",
      "id": "cta_mostrar",
      "label": "Mostrar botón al final",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_texto",
      "label": "Texto del botón",
      "default": "Comprar ahora — Pago contra entrega"
    },
    {
      "type": "text",
      "id": "cta_subtexto",
      "label": "Línea bajo el botón"
    },
    {
      "type": "color",
      "id": "boton_fondo",
      "label": "Fondo del botón",
      "info": "Vacío: el de «Ajustes de la página»."
    },
    {
      "type": "color",
      "id": "boton_color",
      "label": "Texto del botón",
      "info": "Vacío: el de «Ajustes de la página»."
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "bm-b-escena"
    }
  ]
}
{% endschema %}
