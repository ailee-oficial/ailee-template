{%- comment -%}
  Preguntas (kit v2): preguntas frecuentes editables, salidas de las objeciones reales del avatar.
  Fuente canónica: claude-skills/core/tema_landing (kit v2: cada bloque es un theme block, blocks/bm-b-*).
{%- endcomment -%}
{%- render 'bm-v2-recursos' -%}
{%- assign s = section.settings -%}
<div class="bm-sec bm-faq bm-v2" data-bm-landing="faq" data-bm-sec="{{ section.id }}" style="{% if s.fondo != blank %}--bm-sec-bg:{{ s.fondo }};{% endif %}{% if s.texto != blank %}--bm-sec-fg:{{ s.texto }};{% endif %}{% if s.linea != blank %}--bm-linea:{{ s.linea }};{% endif %}--bm-pad-top:{{ s.padding_top }}px;--bm-pad-bottom:{{ s.padding_bottom }}px;--bm-pad-x:{{ s.padding_lateral }}px;--bm-align:{{ s.alineacion }};">
  <div class="bm-sec__in">
    {%- if s.titulo != blank -%}
      <div class="bm-cabecera"><h2>{{ s.titulo | escape }}</h2></div>
    {%- endif -%}
    {%- content_for 'blocks' -%}
  </div>
  {%- if s.cta_mostrar -%}
    {%- render 'bm-cta', texto: s.cta_texto, subtexto: s.cta_subtexto, fondo: blank, color: blank, franja: blank, ancho: 'completo', alineacion: 'center', pad_y: 14, pulso: false -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Preguntas",
  "tag": "section",
  "class": "bm-v2-seccion",
  "enabled_on": {"templates": ["product"]},
  "max_blocks": 16,
  "settings": [
    {"type": "text", "id": "titulo", "label": "Título", "default": "Preguntas frecuentes"},
    {"type": "select", "id": "alineacion", "label": "Alineación del título", "options": [{"value": "left", "label": "Izquierda"}, {"value": "center", "label": "Centro"}], "default": "left"},
    {"type": "color", "id": "fondo", "label": "Fondo de la sección", "info": "Vacío: el de la página."},
    {"type": "color", "id": "texto", "label": "Texto"},
    {"type": "color", "id": "linea", "label": "Línea divisoria"},
    {"type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20},
    {"type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20},
    {"type": "range", "id": "padding_lateral", "label": "Margen lateral", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 16},
    {"type": "header", "content": "Botón de compra"},
    {"type": "checkbox", "id": "cta_mostrar", "label": "Mostrar botón al final", "default": false},
    {"type": "text", "id": "cta_texto", "label": "Texto del botón", "default": "Pedir ahora · pago contra entrega"},
    {"type": "text", "id": "cta_subtexto", "label": "Línea bajo el botón", "default": "Pagas al recibir"}
  ],
  "blocks": [{"type": "@theme"}, {"type": "bm-b-pregunta"}],
  "presets": [{"name": "Preguntas", "blocks": [{"type": "bm-b-pregunta"}, {"type": "bm-b-pregunta"}]}]
}
{% endschema %}
