{{ 'ah-home.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Banner de marca de las plantillas boutique de Ailée (excepción a la regla «sin marca» de la
  landing v2, decidida por la usuaria el 2026-09-23 para Ailée). El nombre es texto editable,
  no el logo del tema.
{%- endcomment -%}
<section class="ah ah-fondo-suave">
  <div class="ah-marca">
    <div class="ah-marca__nombre">
      <p class="ah-marca__wordmark">{{ section.settings.nombre | escape }}</p>
      {%- if section.settings.subnombre != blank -%}<p class="ah-marca__sub">{{ section.settings.subnombre | escape }}</p>{%- endif -%}
    </div>
    <p class="ah-marca__frase">{{ section.settings.frase | escape | newline_to_br }}</p>
    <div class="ah-marca__foto">
      {%- render 'ah-img', imagen: section.settings.imagen, respaldo: section.settings.respaldo, alt: section.settings.nombre, sizes: '(min-width: 750px) 40vw, 100vw', ancho: 2048, alto: 1152 -%}
      {%- if section.settings.firma != blank -%}<p class="ah-marca__firma ah-script">{{ section.settings.firma | escape | newline_to_br }}</p>{%- endif -%}
    </div>
  </div>
</section>
<style>
  .ah-marca { display: grid; grid-template-columns: auto 1fr 1.3fr; align-items: center; gap: clamp(20px, 4vw, 56px); padding: 0 0 0 clamp(20px, 5vw, 72px); min-height: 280px; }
  .ah-marca__wordmark { font-family: var(--ah-serif); font-size: clamp(34px, 3.6vw, 48px); letter-spacing: .32em; line-height: 1; margin: 0; padding-left: .32em; }
  .ah-marca__sub { font-family: var(--ah-serif); font-style: italic; font-size: 17px; letter-spacing: .3em; text-align: center; margin-top: 8px; color: var(--ah-muted); }
  .ah-marca__frase { font-family: var(--ah-serif); font-style: italic; font-size: clamp(26px, 2.6vw, 36px); line-height: 1.25; color: #6b5a48; padding-left: clamp(0px, 3vw, 40px); border-left: 1px solid var(--ah-line); }
  .ah-marca__foto { position: relative; align-self: stretch; min-height: 280px; overflow: hidden; }
  .ah-marca__foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .ah-marca__firma { position: absolute; left: 24px; bottom: 18px; color: #fff; font-size: 30px; transform: rotate(-6deg); text-shadow: 0 1px 12px rgba(0,0,0,.25); margin: 0; }
  @media (max-width: 749px) {
    .ah-marca { grid-template-columns: 1fr; padding: 40px 0 0; text-align: center; gap: 18px; }
    .ah-marca__nombre { justify-self: center; }
    .ah-marca__frase { border-left: 0; padding: 0 20px; }
    .ah-marca__foto { min-height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Ailee · Marca",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "nombre", "label": "Nombre", "default": "AILÉE" },
    { "type": "text", "id": "subnombre", "label": "Debajo del nombre", "default": "Boutique" },
    { "type": "textarea", "id": "frase", "label": "Frase", "default": "Tu estilo.\nTu esencia.\nTu manera de brillar." },
    { "type": "image_picker", "id": "imagen", "label": "Imagen", "info": "Horizontal." },
    { "type": "text", "id": "respaldo", "label": "Imagen provisional del tema" },
    { "type": "textarea", "id": "firma", "label": "Frase manuscrita sobre la imagen (opcional)", "default": "Más que moda,\nuna forma de ser" }
  ],
  "presets": [{ "name": "Ailee · Marca" }]
}
{% endschema %}
