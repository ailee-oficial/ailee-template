        "custom_liquid_KX6Vd4": {
          "type": "custom_liquid",
          "name": "Precio",
          "settings": {
            "custom_liquid": "<div class=\"custom-price-container\">\n  {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}\n    <div class=\"price-header\">\n      <span class=\"price-item price-item--regular\">\n        {{ product.selected_or_first_available_variant.compare_at_price | money }}\n      </span>\n      <span class=\"badge-oferta\">Oferta del día 50% OFF</span>\n    </div>\n  {%- endif -%}\n\n  <div class=\"price-row-inline\">\n    <div class=\"price-main\">\n      <span class=\"price-item price-item--sale\">\n        {{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}\n      </span>\n      <span class=\"currency-code\">COP</span>\n    </div>\n    \n    <div class=\"shipping-tag\">\n      <span class=\"shipping-text\">+ Envíos <strong>GRATIS</strong></span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .custom-price-container {\n    margin: 15px 0;\n    font-family: var(--font-body-family), sans-serif;\n  }\n\n  /* Precio Original Tachado */\n  .price-header {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 5px;\n  }\n\n  .price-item--regular {\n    color: #8c8c8c;\n    text-decoration: line-through;\n    font-size: 1.8rem; /* Tamaño original */\n  }\n\n  /* Badge de Oferta con tu color naranja */\n.badge-oferta {\n  background-color: #3D2B1F;\n  color: #FAF6F0;\n  padding: 3px 14px;\n  border-radius: 0;\n  font-size: 1.1rem;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n  /* Fila de Precio y Envío */\n  .price-row-inline {\n    display: flex;\n    align-items: baseline;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .price-main {\n    display: flex;\n    align-items: baseline;\n    gap: 6px;\n  }\n\n  .price-item--sale {\n    color: #1A1A1A;\n    font-size: 3.3rem; /* Tamaño grande original */\n    font-weight: 900;\n    line-height: 1;\n  }\n\n  .currency-code {\n    font-size: 1.8rem; /* Tamaño original */\n    font-weight: 700;\n    color: #1A1A1A;\n  }\n\n  /* Envío Gratis en la misma línea */\n  .shipping-tag {\n    color: #1A1A1A;\n    font-size: 1.8rem; /* Ajustado para que combine con el COP */\n    font-weight: 700;\n  }\n\n  .shipping-tag strong {\n    font-weight: 900;\n  }\n\n  /* Responsivo */\n  @media (max-width: 480px) {\n    .price-item--sale {\n      font-size: 2.9rem;\n    }\n  }\n</style>"
