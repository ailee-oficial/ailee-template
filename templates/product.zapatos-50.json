          "name": "Guía de tallas visual",
          "settings": {
            "custom_liquid": "<div class=\"talla-urgente\"><div class=\"talla-urgente__left\"><span class=\"talla-urgente__badge\">📏 Guía de tallas</span><p class=\"talla-urgente__title\">¿Seguro/a de tu talla?</p><p class=\"talla-urgente__sub\">Revisa la guía antes de confirmar y elige con confianza.</p></div><button class=\"talla-urgente__btn\" id=\"openSizeGuideUrgente\">Ver guía →</button></div><div id=\"sizeGuideModalUrgente\" class=\"sgu-modal\" aria-hidden=\"true\"><div class=\"sgu-modal-content\" role=\"dialog\"><div class=\"sgu-modal-header\"><h3>Guía de tallas</h3><button type=\"button\" class=\"sgu-close\" id=\"closeSizeGuideUrgente\" aria-label=\"Cerrar\">&times;</button></div><div class=\"sgu-modal-body\"><img src=\"https://cdn.shopify.com/s/files/1/0741/8072/2856/files/tallason_optimized.jpg?v=1773082873\" alt=\"Guía de tallas\" loading=\"lazy\"></div></div></div><style>.talla-urgente{display:flex;align-items:center;justify-content:space-between;gap:14px;background:#FAF6F0;border:1.5px solid #C4A882;border-left:4px solid #3D2B1F;padding:14px 16px;margin:14px 0;}.talla-urgente__left{display:flex;flex-direction:column;gap:3px;flex:1;min-width:0;}.talla-urgente__badge{display:inline-block;font-family:\"Jost\",sans-serif;font-size:1.05rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#3D2B1F;margin-bottom:2px;}.talla-urgente__title{margin:0;font-family:\"Jost\",sans-serif;font-size:1.3rem;font-weight:700;color:#1A1410;line-height:1.3;}.talla-urgente__sub{margin:0;font-family:\"Jost\",sans-serif;font-size:1.15rem;color:#7A6555;line-height:1.4;}.talla-urgente__btn{flex-shrink:0;background:#3D2B1F;color:#FAF6F0;border:none;border-radius:0;cursor:pointer;font-family:\"Jost\",sans-serif;font-size:1.15rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:11px 18px;white-space:nowrap;transition:background .2s;}.talla-urgente__btn:hover{background:#6B4C36;}@media(max-width:600px){.talla-urgente{flex-direction:column;align-items:flex-start;}.talla-urgente__btn{width:100%;text-align:center;}}.sgu-modal{display:none;position:fixed;z-index:9999;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(3px);}.sgu-modal-content{background:#FAF6F0;margin:6% auto;width:90%;max-width:580px;border-radius:0;overflow:hidden;animation:sgu-slide .22s ease-out;}@keyframes sgu-slide{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}.sgu-modal-header{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;background:#3D2B1F;}.sgu-modal-header h3{margin:0;color:#FAF6F0;font-family:\"Cormorant Garamond\",serif;font-size:1.8rem;font-weight:600;}.sgu-close{background:none;border:none;color:#FAF6F0;font-size:2.8rem;line-height:1;cursor:pointer;}.sgu-modal-body{padding:20px;text-align:center;max-height:78vh;overflow-y:auto;}.sgu-modal-body img{max-width:100%;height:auto;}</style><script>(function(){var modal=document.getElementById(\"sizeGuideModalUrgente\");var btn=document.getElementById(\"openSizeGuideUrgente\");var cls=document.getElementById(\"closeSizeGuideUrgente\");btn.onclick=function(){modal.style.display=\"block\";document.body.style.overflow=\"hidden\";};cls.onclick=function(){modal.style.display=\"none\";document.body.style.overflow=\"\";};modal.addEventListener(\"click\",function(e){if(e.target===modal){modal.style.display=\"none\";document.body.style.overflow=\"\";}});})();</script>"
          }
        }
