        "custom_liquid_iWDE9T": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"size-guide-trigger-container\">\n  <button type=\"button\" class=\"size-guide-button\" id=\"openSizeGuide\">\n    <span class=\"icon-ruler\"></span> Guía de tallas\n  </button>\n</div>\n\n<div id=\"sizeGuideModal\" class=\"size-modal\">\n<h3></h3>\n  <div class=\"size-modal-content\">\n    <div class=\"size-modal-header\">\n      <button type=\"button\" class=\"close-size-modal\" id=\"closeSizeGuide\">&times;</button>\n    </div>\n    <div class=\"size-modal-body\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0741/8072/2856/files/cosmos_optimized_1.png?v=1772406401\" alt=\"Guía de tallas\" loading=\"lazy\">\n    </div>\n  </div>\n</div>\n\n<style>\n  /* Contenedor del botón */\n  .size-guide-trigger-container {\n    margin: 10px 0;\n  }\n\n  .size-guide-button {\n    background: none;\n    border: none;\n    color: #1A1A1A;\n    text-decoration: underline;\n    font-size: 1.4rem;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    padding: 0;\n    font-weight: 500;\n  }\n\n  /* El fondo del Pop-up (Overlay) */\n  .size-modal {\n    display: none; \n    position: fixed;\n    z-index: 9999;\n    left: 0;\n    top: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0,0,0,0.6);\n    backdrop-filter: blur(3px);\n  }\n\n  /* Contenedor blanco */\n  .size-modal-content {\n    background-color: #fff;\n    margin: 5% auto;\n    padding: 0;\n    width: 90%;\n    max-width: 600px;\n    border-radius: 8px;\n    position: relative;\n    box-shadow: 0 4px 20px rgba(0,0,0,0.2);\n    animation: slideIn 0.3s ease-out;\n  }\n\n  @keyframes slideIn {\n    from { transform: translateY(-30px); opacity: 0; }\n    to { transform: translateY(0); opacity: 1; }\n  }\n\n  /* Cabecera del Pop-up */\n  .size-modal-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 15px 20px;\n    border-bottom: 1px solid #eee;\n  }\n\n  .size-modal-header h3 {\n    margin: 0;\n    font-size: 1.8rem;\n    color: #1A1A1A;\n  }\n\n  .close-size-modal {\n    background: none;\n    border: none;\n    font-size: 3rem;\n    line-height: 1;\n    cursor: pointer;\n    color: #888;\n  }\n\n  /* Cuerpo donde va la imagen */\n  .size-modal-body {\n    padding: 20px;\n    max-height: 80vh;\n    overflow-y: auto;\n    text-align: center;\n  }\n\n  .size-modal-body img {\n    max-width: 100%;\n    height: auto;\n    border-radius: 4px;\n  }\n\n  /* Móvil */\n  @media (max-width: 480px) {\n    .size-modal-content {\n      margin: 15% auto;\n      width: 95%;\n    }\n  }\n</style>\n\n<script>\n  const modal = document.getElementById(\"sizeGuideModal\");\n  const btn = document.getElementById(\"openSizeGuide\");\n  const span = document.getElementById(\"closeSizeGuide\");\n\n  // Abrir\n  btn.onclick = function() {\n    modal.style.display = \"block\";\n    document.body.style.overflow = \"hidden\"; // Evita scroll de fondo\n  }\n\n  // Cerrar con la X\n  span.onclick = function() {\n    modal.style.display = \"none\";\n    document.body.style.overflow = \"auto\";\n  }\n\n  // Cerrar haciendo clic fuera del cuadro blanco\n  window.onclick = function(event) {\n    if (event.target == modal) {\n      modal.style.display = \"none\";\n      document.body.style.overflow = \"auto\";\n    }\n  }\n</script>"
          }
        },
