            "custom_liquid": "<div class=\"testimonials-carousel-wrapper\">\n   <div class=\"testimonials-container\">\n   \n               <div class=\"testimonial-card\">\n         <div class=\"testimonial-main-layout\">\n            <div class=\"testimonial-image\">\n               <img src=\"https://cdn.shopify.com/s/files/1/0741/8072/2856/files/4_optimized.jpg?v=1772406794\" alt=\"Cliente Cosmos\">\n            </div>\n            <div class=\"testimonial-body-content\">\n               <div class=\"testimonial-stars\">★★★★★</div>\n               <p class=\"testimonial-text\">\"Muy comodos, valoro especialmente el servicio al cliente, me equivoque con la talla y no tuvieron problema para cambiarla. Muy recomendados.\"</p>\n               <div class=\"testimonial-footer\">\n                  <span class=\"verified-icon\">\n                     <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M10.2426 16.3137L6 12.071L7.41421 10.6568L10.2426 13.4853L15.8995 7.8284L17.3137 9.24264L10.2426 16.3137Z\" fill=\"#3E84F4\"/>\n                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21ZM12 23C18.0751 23 23 18.0751 23 12C23 5.92487 18.0751 1 12 1C5.92487 1 1 5.92487 1 12C1 18.0751 5.92487 23 12 23Z\" fill=\"#3E84F4\"/>\n                     </svg>\n                  </span>\n                  <span class=\"client-info\"><strong>Luisa R.</strong> (Bucaramanga) 🇨🇴</span>\n               </div>\n            </div>\n         </div>\n      </div>\n   \n   \n      <div class=\"testimonial-card\">\n         <div class=\"testimonial-main-layout\">\n            <div class=\"testimonial-image\">\n               <img src=\"https://cdn.shopify.com/s/files/1/0741/8072/2856/files/1_optimized.jpg?v=1772406794\" alt=\"Cliente Cosmos\">\n            </div>\n            <div class=\"testimonial-body-content\">\n               <div class=\"testimonial-stars\">★★★★★</div>\n               <p class=\"testimonial-text\">\"La calidad de los materiales superó mis expectativas. Son muy cómodos para el diario y el color es idéntico a la foto.\"</p>\n               <div class=\"testimonial-footer\">\n                  <span class=\"verified-icon\">\n                     <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M10.2426 16.3137L6 12.071L7.41421 10.6568L10.2426 13.4853L15.8995 7.8284L17.3137 9.24264L10.2426 16.3137Z\" fill=\"#3E84F4\"/>\n                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21ZM12 23C18.0751 23 23 18.0751 23 12C23 5.92487 18.0751 1 12 1C5.92487 1 1 5.92487 1 12C1 18.0751 5.92487 23 12 23Z\" fill=\"#3E84F4\"/>\n                     </svg>\n                  </span>\n                  <span class=\"client-info\"><strong>Luis R.</strong> (Medellín) 🇨🇴</span>\n               </div>\n            </div>\n         </div>\n      </div>\n      <div class=\"testimonial-card\">\n         <div class=\"testimonial-main-layout\">\n            <div class=\"testimonial-image\">\n               <img src=\"https://cdn.shopify.com/s/files/1/0741/8072/2856/files/2_optimized.jpg?v=1772406794\" alt=\"Cliente Cosmos\">\n            </div>\n            <div class=\"testimonial-body-content\">\n               <div class=\"testimonial-stars\">★★★★</div>\n               <p class=\"testimonial-text\">\"Llegaron en 2 días a Cartagena. El pago contra entrega me dio mucha seguridad. Excelente servicio al cliente.\"</p>\n               <div class=\"testimonial-footer\">\n                  <span class=\"verified-icon\">\n                     <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M10.2426 16.3137L6 12.071L7.41421 10.6568L10.2426 13.4853L15.8995 7.8284L17.3137 9.24264L10.2426 16.3137Z\" fill=\"#3E84F4\"/>\n                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21ZM12 23C18.0751 23 23 18.0751 23 12C23 5.92487 18.0751 1 12 1C5.92487 1 1 5.92487 1 12C1 18.0751 5.92487 23 12 23Z\" fill=\"#3E84F4\"/>\n                     </svg>\n                  </span>\n                  <span class=\"client-info\"><strong>Paula M.</strong> (Cartagena) 🇨🇴</span>\n               </div>\n            </div>\n         </div>\n      </div>\n      \n      <div class=\"testimonial-card\">\n         <div class=\"testimonial-main-layout\">\n            <div class=\"testimonial-image\">\n               <img src=\"https://cdn.shopify.com/s/files/1/0741/8072/2856/files/3_optimized.jpg?v=1772406794\" alt=\"Cliente Cosmos\">\n            </div>\n            <div class=\"testimonial-body-content\">\n               <div class=\"testimonial-stars\">★★★★★</div>\n               <p class=\"testimonial-text\">\"Súper livianos y la talla es exacta según la guía. El envío gratis es un ahorro real. Muy recomendados.\"</p>\n               <div class=\"testimonial-footer\">\n                  <span class=\"verified-icon\">\n                     <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M10.2426 16.3137L6 12.071L7.41421 10.6568L10.2426 13.4853L15.8995 7.8284L17.3137 9.24264L10.2426 16.3137Z\" fill=\"#3E84F4\"/>\n                        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 21C16.9706 21 21 16.9706 21 12C21 7.02944 16.9706 3 12 3C7.02944 3 3 7.02944 3 12C3 16.9706 7.02944 21 12 21ZM12 23C18.0751 23 23 18.0751 23 12C23 5.92487 18.0751 1 12 1C5.92487 1 1 5.92487 1 12C1 18.0751 5.92487 23 12 23Z\" fill=\"#3E84F4\"/>\n                     </svg>\n                  </span>\n                  <span class=\"client-info\"><strong>Camilo G.</strong> (Cali) 🇨🇴</span>\n               </div>\n            </div>\n         </div>\n      </div>\n      \n      \n   </div>\n</div>\n<style>\n   .testimonials-carousel-wrapper {\n   width: 100%;\n   /* Reducimos al mínimo los márgenes superior e inferior */\n   padding: 0px 0; \n   margin-top: 0;\n   margin-bottom: 0;\n   overflow: hidden;\n   }\n   .testimonials-container {\n   display: flex;\n   overflow-x: auto;\n   scroll-snap-type: x mandatory;\n   gap: 12px;\n   /* Ajustamos el padding lateral para que no toque los bordes del cel */\n   padding: 5px 15px; \n   scrollbar-width: none;\n   -webkit-overflow-scrolling: touch;\n   }\n   .testimonials-container::-webkit-scrollbar { display: none; }\n   .testimonial-card {\n   flex: 0 0 88%; /* Ancho perfecto para ver un poco de la siguiente tarjeta */\n   scroll-snap-align: center;\n   background: #fff;\n   border: 1px solid #f0f0f0;\n   border-radius: 10px;\n   padding: 14px;\n   box-sizing: border-box;\n   box-shadow: 0 2px 6px rgba(0,0,0,0.03);\n   }\n   .testimonial-main-layout {\n   display: flex;\n   align-items: flex-start;\n   gap: 12px;\n   }\n   .testimonial-image img {\n   width: 50px;\n   height: 50px;\n   border-radius: 50%;\n   object-fit: cover;\n   background: #f9f9f9;\n   flex-shrink: 0;\n   }\n   .testimonial-body-content {\n   flex: 1;\n   min-width: 0;\n   }\n   .testimonial-stars {\n   font-size: 0.9rem;\n   margin-bottom: 4px;\n   }\n   .testimonial-text {\n   margin: 0;\n   font-size: 1.3rem;\n   line-height: 1.3;\n   color: #333;\n   word-break: break-word;\n   }\n   .testimonial-footer {\n   display: flex;\n   align-items: center;\n   gap: 5px;\n   margin-top: 10px;\n   padding-top: 8px;\n   border-top: 1px solid #f5f5f5;\n   }\n   .verified-icon svg {\n   width: 15px;\n   height: 15px;\n   }\n   .client-info {\n   font-size: 1.1rem;\n   color: #666;\n   }\n   @media (min-width: 768px) {\n   .testimonial-card { flex: 0 0 350px; }\n   .testimonials-container { justify-content: center; }\n   }\n</style>"
