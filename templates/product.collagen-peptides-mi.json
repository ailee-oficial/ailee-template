        "cta_inmediato": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .product-form__submit { display: none !important; }\n\n  #cta-inmediato {\n    width: 100%;\n    min-height: 51px;\n    margin-top: 10px;\n    margin-bottom: 10px;\n    padding: 12px 20px 14px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n    border: 0;\n    border-radius: 13px;\n    background: #1C1C1C;\n    color: #fff;\n    font-family: inherit;\n    font-size: 17.6px;\n    font-weight: 600;\n    line-height: 1.3;\n    text-align: center;\n    cursor: pointer;\n    appearance: none;\n    animation: cta-wave 2s ease-out infinite, cta-bounce 2s ease-in-out infinite;\n  }\n  #cta-inmediato .cta-icono { flex: 0 0 auto; margin-right: 14px; }\n  #cta-inmediato .cta-sub {\n    display: block;\n    margin-top: 3px;\n    font-size: 90%;\n    font-weight: 400;\n    opacity: 0.95;\n  }\n  #cta-inmediato[data-esperando=\"1\"] { opacity: 0.75; }\n\n  @keyframes cta-wave {\n    0%   { box-shadow: 0 0 0 0 rgba(28,28,28,.35); }\n    60%  { box-shadow: 0 0 0 14px rgba(28,28,28,0); }\n    100% { box-shadow: 0 0 0 0  rgba(28,28,28,0); }\n  }\n  @keyframes cta-bounce {\n    0%,100% { transform: translateY(0); }\n    30%     { transform: translateY(-4px); }\n    60%     { transform: translateY(-2px); }\n  }\n  ._rsi-buy-now-button-product,\n  body ._rsi-buy-now-button-product,\n  .product-form ._rsi-buy-now-button-product {\n    background-color: #1C1C1C !important;\n    background: #1C1C1C !important;\n    border-color: #1C1C1C !important;\n    animation: cta-wave 2s ease-out infinite, cta-bounce 2s ease-in-out infinite !important;\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #cta-inmediato, ._rsi-buy-now-button-product { animation: none !important; }\n  }\n\n  body:has(._rsi-buy-now-button-product) #cta-inmediato { display: none; }\n</style>\n\n<button type=\"button\" id=\"cta-inmediato\" aria-label=\"Comprar con pago contra entrega\">\n  <svg class=\"cta-icono\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n    <path d=\"M3 6h11v9H3z\"/><path d=\"M14 9h4l3 3v3h-7z\"/>\n    <circle cx=\"7\" cy=\"17.5\" r=\"1.8\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.8\"/>\n  </svg>\n  <span>\n    CLICK AQUI, PAGA EN CASA\n    <span class=\"cta-sub\">¡ENVIO GRATIS!</span>\n  </span>\n</button>\n\n<script>\n(function () {\n  var SELECTOR_REAL = \"._rsi-buy-now-button-product\";\n  var MS_ESPERA_MAXIMA = 12000;\n  var MS_INTENCION_VALIDA = 15000;\n\n  var placeholder = document.getElementById(\"cta-inmediato\");\n  if (!placeholder) return;\n\n  var contenedor = placeholder.closest(\".product-form__buttons\") || document;\n  var intencionEn = 0;\n  var resuelto = false;\n\n  function botonReal() {\n    return contenedor.querySelector(SELECTOR_REAL) || document.querySelector(SELECTOR_REAL);\n  }\n\n  function activar(real) {\n    if (resuelto) return;\n    resuelto = true;\n    observador.disconnect();\n    placeholder.style.display = \"none\";\n    real.style.setProperty(\"background-color\",\"#1C1C1C\",\"important\");\n    real.style.setProperty(\"background\",\"#1C1C1C\",\"important\");\n    real.style.setProperty(\"border-color\",\"#1C1C1C\",\"important\");\n\n    var aTiempo = intencionEn && (Date.now() - intencionEn) < MS_INTENCION_VALIDA;\n    if (aTiempo) real.click();\n  }\n\n  function rendirse() {\n    if (resuelto) return;\n    resuelto = true;\n    observador.disconnect();\n    placeholder.style.display = \"none\";\n    var nativo = document.querySelector(\".product-form__submit\");\n    if (nativo) nativo.style.setProperty(\"display\", \"flex\", \"important\");\n  }\n\n  placeholder.addEventListener(\"click\", function () {\n    var real = botonReal();\n    if (real) { activar(real); return; }\n    intencionEn = Date.now();\n    placeholder.setAttribute(\"data-esperando\", \"1\");\n  });\n\n  var observador = new MutationObserver(function () {\n    var real = botonReal();\n    if (real) activar(real);\n  });\n  observador.observe(document.body, { childList: true, subtree: true });\n\n  var yaEstaba = botonReal();\n  if (yaEstaba) activar(yaEstaba);\n  else setTimeout(rendirse, MS_ESPERA_MAXIMA);\n})();\n</script>\n"
          }
        },
