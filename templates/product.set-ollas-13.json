        "titulo_verificado": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div style=\"padding:4px 0 0;\"><div style=\"color:#C9A96E;font-size:1rem;margin-bottom:6px;\">★★★★★ <span style=\"color:#7A7A7A;font-size:.85rem;font-weight:500;\">+200 pedidos</span></div><h1 style=\"font-family:var(--font-heading-family),serif;font-size:1.8rem;font-weight:700;color:#1C1C1C;margin:0 0 4px;line-height:1.25;\">Set de Ollas 13 Piezas</h1><p style=\"font-size:.9rem;color:#7A7A7A;margin:0;\">Antiadherente · 2 Colores Disponibles</p></div>"
          }
        },
        "precio_block": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign v = product.selected_or_first_available_variant -%}<div style=\"margin:14px 0 8px;padding:16px;background:#fff;border:1px solid #EDE8E3;border-radius:14px;box-shadow:0 2px 12px rgba(28,28,28,.05);\"><div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;\">{%- if v.compare_at_price > v.price -%}<span style=\"font-size:1.5rem;color:#B0A090;text-decoration:line-through;\">{{ v.compare_at_price | money_without_trailing_zeros }}</span>{%- assign s = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}<span style=\"background:#C4A882;color:#fff;font-size:.8rem;font-weight:800;padding:3px 10px;border-radius:8px;\">-{{ s }}% DCTO</span>{%- endif -%}</div><div style=\"font-size:3.2rem;font-weight:800;color:#1C1C1C;line-height:1;letter-spacing:-.02em;margin-bottom:12px;\">{{ v.price | money_without_trailing_zeros }}</div><div style=\"display:flex;gap:14px;flex-wrap:wrap;\"><span style=\"font-size:.95rem;font-weight:700;color:#1C1C1C;\">🚚 Envío Gratis</span><span style=\"font-size:.95rem;font-weight:700;color:#1C1C1C;\">💰 Paga al Recibir</span></div></div>"
          }
        },
        "ollas_estilos": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>.variant-picker--color{margin:8px 0 4px}.variant-picker--color input[type=radio]{position:absolute!important;width:1px;height:1px;opacity:0;pointer-events:none}.variant-picker--color label{display:inline-block!important;width:72px!important;height:72px!important;min-width:72px!important;padding:0!important;margin:0 10px 10px 0!important;border-radius:12px!important;border:2px solid #EDE8E3!important;background:#fff center/cover no-repeat!important;font-size:0!important;line-height:0!important;cursor:pointer!important;position:relative!important;transition:border-color .15s,box-shadow .15s!important;box-shadow:none!important}.variant-picker--color input:checked+label{border-color:#C4A882!important;box-shadow:0 0 0 2px #C4A882!important}.variant-picker--color input:checked+label:before{content:'✓'!important;position:absolute;top:-9px;right:-9px;width:22px;height:22px;border-radius:50%;background:#C4A882;color:#fff;font-size:13px;line-height:22px;text-align:center;z-index:3}variant-radios legend{font-size:1.2rem;font-weight:700;color:#1C1C1C;margin-bottom:10px;width:100%;text-transform:none;letter-spacing:0}variant-radios .variant-picker--color label{width:72px!important;height:72px!important;min-width:72px!important;border-radius:12px!important;border:2px solid #EDE8E3!important;background-color:#fff!important;text-indent:-9999px!important}variant-radios .variant-picker--color input:checked+label{border:2px solid #C4A882!important;box-shadow:none!important}variant-radios .variant-picker--color input:checked+label:before{content:'✓'!important;position:absolute;top:-8px;right:-8px;width:22px;height:22px;border-radius:50%;background:#C4A882;color:#fff;font-size:13px;line-height:22px;text-align:center;text-indent:0!important;z-index:5}</style><script>(function(){function setImg(){var labels=document.querySelectorAll('.variant-picker--color label');if(!labels.length)return;var vi={};{% for v in product.variants %}{% if v.featured_image %}vi['{{ v.option1 | downcase }}']='{{ v.featured_image | image_url: width: 200 }}';{% endif %}{% endfor %}labels.forEach(function(l){var i=l.previousElementSibling;if(!i)return;var val=(i.value||'').toLowerCase();if(vi[val])l.style.backgroundImage='url('+vi[val]+')'})}function lbl(){var f=document.querySelector('.variant-picker--color');if(!f)return;var lg=f.querySelector('legend');var c=f.querySelector('input:checked');if(lg&&c)lg.textContent='COLOR: '+c.value}function go(){setImg();lbl()}document.addEventListener('change',function(e){if(e.target.closest&&e.target.closest('.variant-picker--color'))lbl()});document.addEventListener('DOMContentLoaded',function(){setTimeout(go,400)});setTimeout(go,900)})()</script>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
