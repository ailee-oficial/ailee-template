0\" height=\"1080\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\" style=\"width:100%;height:115%;object-fit:cover;object-position:center top;display:block;\"></div>\n</div>\n<div style=\"display:flex;justify-content:center;align-items:center;gap:10px;padding:12px 0 6px;\">\n<span class=\"hero-dot active\" data-idx=\"0\"></span>\n<span class=\"hero-dot\" data-idx=\"1\"></span>\n<span class=\"hero-dot\" data-idx=\"2\"></span>\n</div>\n<div id=\"hero-color-label\" style=\"text-align:center;padding:0 0 16px;font-size:.85rem;font-weight:800;letter-spacing:3px;color:#9A8A7A;text-transform:uppercase;\">NEGRO</div>\n</div>\n<script>\n(function(){\nvar slides=document.getElementById('hero-slides');\nvar dots=document.querySelectorAll('.hero-dot');\nvar label=document.getElementById('hero-color-label');\nvar colors=['negro','azul','rosado'];\nvar labels=['NEGRO','AZUL','ROSADO'];\nvar current=0;\n\nfunction goTo(idx,fromVariant){\nif(idx<0||idx>=3||idx===current)return;\ncurrent=idx;\nslides.scrollTo({left:idx*slides.offsetWidth,behavior:'smooth'});\ndots.forEach(function(d,i){d.classList.toggle('active',i===idx)});\nlabel.textContent=labels[idx];\nif(!fromVariant){\nvar inputs=document.querySelectorAll('.variant-picker--color input[type=radio]');\ninputs.forEach(function(inp){\nif(inp.value.toLowerCase()===colors[idx]){\ninp.checked=true;\ninp.dispatchEvent(new Event('change',{bubbles:true}));\n}\n});\n}\n}\n\ndots.forEach(function(d){\nd.addEventListener('click',function(){goTo(parseInt(d.dataset.idx))});\n});\n\nvar debounce;\nslides.addEventListener('scroll',function(){\nclearTimeout(debounce);\ndebounce=setTimeout(function(){\nvar idx=Math.round(slides.scrollLeft/slides.offsetWidth);\nif(idx!==current){\ncurrent=-1;\ngoTo(idx);\n}\n},100);\n});\n\ndocument.addEventListener('change',function(e){\nvar inp=e.target;\nif(inp.closest&&inp.closest('.variant-picker--color')){\nvar val=(inp.value||'').toLowerCase();\nvar idx=colors.indexOf(val);\nif(idx>=0){\ncurrent=-1;\ngoTo(idx,true);\n}\n}\n});\n\nsetTimeout(function(){\nvar checked=document.querySelector('.variant-picker--color input:checked');\nif(checked){\nvar val=(checked.value||'').toLowerCase();\nvar idx=colors.indexOf(val);\nif(idx>=0&&idx!==0){\ncurrent=-1;\ngoTo(idx,true);\n}\n}\n},600);\n})();\n</script>"
