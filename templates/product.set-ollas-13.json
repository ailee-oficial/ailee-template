olute;top:-10px;right:-10px;width:24px;height:24px;border-radius:50%;background:#C4A882;color:#fff;font-size:14px;line-height:24px;text-align:center;text-indent:0!important;z-index:5}.product__description a[onclick]{animation:cta-wave 2s ease-out infinite,cta-bounce 2s ease-in-out infinite!important}@keyframes cta-wave{0%{box-shadow:0 0 0 0 rgba(28,28,28,.35)}60%{box-shadow:0 0 0 14px rgba(28,28,28,0)}100%{box-shadow:0 0 0 0 rgba(28,28,28,0)}}@keyframes cta-bounce{0%,100%{transform:translateY(0)}30%{transform:translateY(-4px)}60%{transform:translateY(-2px)}}@media (prefers-reduced-motion:reduce){.product__description a[onclick]{animation:none!important}}</style><script>(function(){function setImg(){var labels=document.querySelectorAll('.variant-picker--color label');if(!labels.length)return;var vi={'negro':'https://cdn.shopify.com/s/files/1/0659/7214/2165/files/3f8657f6d4986f3f4d885f981cc7efe3.webp?v=1786676627','azul':'https://cdn.shopify.com/s/files/1/0659/7214/2165/files/0a04828c3ed29ab316c85c4efc2b6370.webp?v=1786676629','rosado':'https://cdn.shopify.com/s/files/1/0659/7214/2165/files/rosado_shopify.webp?v=1786745125'};labels.forEach(function(l){var i=l.previousElementSibling;if(!i)return;var val=(i.value||'').toLowerCase();if(vi[val])l.style.setProperty('background-image','url('+vi[val]+')','important')})}function lbl(){var f=document.querySelector('.variant-picker--color');if(!f)return;var lg=f.querySelector('legend');var c=f.querySelector('input:checked');if(lg&&c)lg.textContent='COLOR: '+c.value}function go(){setImg();lbl()}document.addEventListener('change',function(e){if(e.target.closest&&e.target.closest('.variant-picker--color'))lbl()});document.addEventListener('DOMContentLoaded',function(){setTimeout(go,150)})})()</script>"
