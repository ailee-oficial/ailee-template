      "blocks": {
        "b01_pregunta": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué talla es?",
            "respuesta": "<p>Es talla única y se adapta de S a L. La tela Suplex es muy elástica.</p>"
          }
        },
        "b02_pregunta": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Es muy largo?",
            "respuesta": "<p>La bota campana es larga y cae sobre el tenis. Si eres de baja estatura, te queda mejor con tenis de plataforma.</p>"
          }
        },
        "b03_pregunta": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Transparenta?",
            "respuesta": "<p>Según la ficha del proveedor, la tela Suplex de 420 g tiene transparencia baja. Te recomendamos ropa interior del tono de tu piel o sin costuras.</p>"
          }
        },
        "b04_pregunta": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Moldea como una faja?",
            "respuesta": "<p>No. Estiliza por el corte: la bota campana, el frunce trasero y la espalda en tiras. Su compresión es media.</p>"
          }
        },
        "b05_pregunta": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo funciona la oferta?",
            "respuesta": "<p>Paga 2 y lleva 3: tres enterizos por $159.700. En el formulario también puedes elegir 1 por $89.700 o 2 por $129.700 (la segunda con descuento). Eliges el color de cada uno.</p>"
          }
        },
        "b06_pregunta": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuándo llega y cómo pago?",
            "respuesta": "<p>Llega en 3 a 5 días hábiles y pagas cuando lo recibes en la puerta de tu casa.</p>"
          }
        }
      },
