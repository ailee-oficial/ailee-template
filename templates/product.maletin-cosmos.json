        "custom_2x1_explain": {
          "type": "custom_liquid",
          "name": "Guía PAR 1 + PAR 2",
          "settings": {
            "custom_liquid": "<div class=\"par-guide\"><div class=\"par-guide__step\"><span class=\"par-guide__num\">1</span><div class=\"par-guide__content\"><p class=\"par-guide__title\">Elige el color y la talla de tu <strong>primer par</strong></p><p class=\"par-guide__desc\">Usa los botones de arriba para seleccionar color y talla.</p></div></div><div class=\"par-guide__divider\"></div><div class=\"par-guide__step\"><span class=\"par-guide__num\">2</span><div class=\"par-guide__content\"><p class=\"par-guide__title\">El <strong>segundo par</strong> lo eliges en el formulario</p><p class=\"par-guide__desc\">Al dar clic en el botón de abajo se abre el formulario — ahí indicas el color y la talla del segundo par.</p></div></div></div><style>.par-guide{background:#e8e8e8;border-left:4px solid #000000;padding:18px 20px;margin:16px 0;}.par-guide__step{display:flex;align-items:flex-start;gap:14px;}.par-guide__num{flex-shrink:0;width:28px;height:28px;background:#000000;color:#FFFFFF;font-family:\"Jost\",sans-serif;font-size:1.3rem;font-weight:700;display:flex;align-items:center;justify-content:center;}.par-guide__content{flex:1;}.par-guide__title{margin:0 0 3px;font-family:\"Jost\",sans-serif;font-size:1.3rem;font-weight:600;color:#111111;line-height:1.3;}.par-guide__title strong{color:#000000;}.par-guide__desc{margin:0;font-family:\"Jost\",sans-serif;font-size:1.2rem;color:#555555;line-height:1.5;}.par-guide__divider{border-top:1px solid rgba(0,0,0,.12);margin:14px 0;}</style>"
          }
        },
        "custom_size_guide_visual": {
          "type": "custom_liquid",
          "name": "Guía de tallas visual",
          "settings": {
            "custom_liquid": "{%- assign tallas_img = product.images.last -%}\n<div class=\"talla-urgente\"><div class=\"talla-urgente__left\"><span class=\"talla-urgente__badge\">📏 Guía de tallas</span><p class=\"talla-urgente__title\">¿Seguro/a de tu talla?</p><p class=\"talla-urgente__sub\">Revisa la guía antes de confirmar y elige con confianza.</p></div><button class=\"talla-urgente__btn\" id=\"btnAbrirGuia\">Ver guía →</button></div>\n\n<div id=\"guiaModal\" style=\"display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;align-items:center;justify-content:center;padding:16px;\">\n  <div style=\"background:#fff;border-radius:14px;width:100%;max-width:440px;max-height:90vh;overflow-y:auto;\">\n    <div style=\"display:flex;align-items:center;justify-content:space-between;padding:16px 20px 12px;border-bottom:1px solid #eee;\">\n      <h3 style=\"font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:600;color:#111;margin:0;flex:1;text-align:center;\">Guía de tallas</h3>\n      <button id=\"btnCerrarGuia\" style=\"background:none;border:none;font-size:3rem;color:#6B6B6B;cursor:pointer;line-height:1;\">×</button>\n    </div>\n    <div style=\"padding:16px 20px 24px;text-align:center;\">\n      {%- if tallas_img -%}<img src=\"{{ tallas_img | image_url: width: 800 }}\" alt=\"Guía de tallas\" style=\"width:100%;border-radius:8px;margin-bottom:14px;\">{%- else -%}<p style=\"font-size:1.3rem;color:#555;padding:20px 0;\">Guía de tallas no disponible.</p>{%- endif -%}\n      <p style=\"font-size:1.2rem;color:#000;margin:8px 0 0;\">Si estás entre dos tallas, <strong>elige la más grande.</strong></p>\n    </div>\n  </div>\n</div>\n\n<style>\n.talla-urgente{display:flex;align-items:center;justify-content:space-between;gap:14px;background:#FFF;border:1.5px solid #000;border-left:4px solid #000;padding:14px 16px;border-radius:6px;margin:16px 0}\n.talla-urgente__left{flex:1}.talla-urgente__badge{font-size:1.1rem;font-weight:600;color:#000;display:block;margin-bottom:4px}\n.talla-urgente__title{font-size:1.4rem;font-weight:700;color:#111;margin:0 0 2px}.talla-urgente__sub{font-size:1.15rem;color:#6B6B6B;margin:0}\n.talla-urgente__btn{white-space:nowrap;background:#000;color:#FFF;border:none;padding:10px 18px;font-size:1.2rem;font-weight:600;border-radius:4px;cursor:pointer}\n</style>\n<script>(function(){var m=document.getElementById('guiaModal');function a(){m.style.display='flex';document.body.style.overflow='hidden';}function c(){m.style.display='none';document.body.style.overflow='';}document.getElementById('btnAbrirGuia').addEventListener('click',a);document.getElementById('btnCerrarGuia').addEventListener('click',c);m.addEventListener('click',function(e){if(e.target===m)c();});})();</script>"
          }
        }
      },
