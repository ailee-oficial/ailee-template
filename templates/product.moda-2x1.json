        "custom_size_guide_visual": {
          "type": "custom_liquid",
          "name": "guia det tallas",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign guia_url = ''\n  for im in product.images\n    assign meta = im.src | append: ' ' | append: im.alt | downcase\n    if meta contains 'talla' or meta contains 'guia' or meta contains 'medida' or meta contains 'size'\n      assign guia_url = im | image_url: width: 800\n    endif\n  endfor\n  if guia_url == ''\n    assign ult = product.images.last\n    assign alt_ult = ult.alt | default: '' | downcase\n    assign es_foto_color = false\n    if alt_ult contains '_'\n      assign partes = alt_ult | split: '_'\n      assign sufijo = partes | last | plus: 0\n      if sufijo > 0\n        assign es_foto_color = true\n      endif\n    endif\n    if ult != blank and es_foto_color == false\n      assign guia_url = ult | image_url: width: 800\n    endif\n  endif\n  if guia_url == ''\n    assign guia_url = ''\n  endif\n-%}\n<div class=\"guia-talla-link\"><span class=\"guia-talla-icon\">📏</span><a href=\"#\" id=\"btnAbrirGuia\" class=\"guia-talla-a\">Encuentra tu talla aquí</a></div>\n\n<div id=\"guiaModal\" style=\"display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;align-items:center;justify-content:center;padding:16px;\">\n  <div style=\"background:var(--cm-cream, #FAF7F4);border-radius:14px;width:100%;max-width:440px;max-height:90vh;max-height:90dvh;overflow-y:auto;-webkit-overflow-scrolling:touch;\">\n    <div style=\"display:flex;align-items:center;justify-content:space-between;padding:12px 16px 8px;border-bottom:1px solid #eee;\">\n      <h3 style=\"font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:600;color:#111;margin:0;flex:1;text-align:center;\">Guía de tallas</h3>\n      <button id=\"btnCerrarGuia\" style=\"background:none;border:none;font-size:2.2rem;color:#6B6B6B;cursor:pointer;line-height:1;\">×</button>\n    </div>\n    <div style=\"padding:14px 16px 18px;text-align:center;\">\n      <img src=\"{{ guia_url }}\" alt=\"Guía de tallas\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;border-radius:8px;margin-bottom:14px;\">\n      <p style=\"font-size:1.2rem;color:#000;margin:8px 0 12px;\">Si estás entre dos tallas, <strong>elige la más grande.</strong></p>\n      <button class=\"gtx-close-btn\" id=\"btnCerrarGuia2\">Entendido, cerrar</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.guia-talla-link{display:flex;align-items:center;gap:6px;margin:10px 0;padding:0}\n.guia-talla-icon{font-size:13px;opacity:.7}\n.guia-talla-a{color:#111!important;font-size:12px!important;text-decoration:underline!important;text-underline-offset:2px;cursor:pointer;font-weight:500!important;text-transform:none!important;background:none;border:none}\n.guia-talla-a:hover{color:#111}\n.gtx-close-btn{display:block;width:100%;background:#000;color:var(--cm-cream, #FAF7F4);border:none;padding:10px 0;font-size:1.05rem;font-weight:700;border-radius:6px;cursor:pointer}\n</style>\n<script>(function(){var m=document.getElementById('guiaModal');function a(){m.style.display='flex';document.body.style.overflow='hidden';}function c(){m.style.display='none';document.body.style.overflow='';}document.getElementById('btnAbrirGuia').addEventListener('click',function(e){e.preventDefault();a();});document.getElementById('btnCerrarGuia').addEventListener('click',c);document.getElementById('btnCerrarGuia2').addEventListener('click',c);m.addEventListener('click',function(e){if(e.target===m)c();});})();</script>"
          }
        },
