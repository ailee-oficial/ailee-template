        "cta_inmediato": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .product-form__submit { display: none !important; }\n\n  #cta-inmediato {\n    width: 100%;\n    min-height: 51px;\n    margin-top: 10px;\n    margin-bottom: 10px;\n    padding: 12px 20px 14px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-sizing: border-box;\n    border: 0;\n    border-radius: 13px;\n    background: rgba(29, 158, 6, 1);\n    color: #fff;\n    font-family: inherit;\n    font-size: 17.6px;\n    font-weight: 600;\n    line-height: 1.3;\n    text-align: center;\n    cursor: pointer;\n    appearance: none;\n    animation: cta-shake 2.5s ease-in-out 1.5s infinite;\n  }\n  #cta-inmediato .cta-icono { flex: 0 0 auto; margin-right: 14px; }\n  #cta-inmediato .cta-sub {\n    display: block;\n    margin-top: 3px;\n    font-size: 90%;\n    font-weight: 400;\n    opacity: 0.95;\n  }\n  #cta-inmediato[data-esperando=\"1\"] { opacity: 0.75; }\n\n  @keyframes cta-shake {\n    0%, 88%, 100% { transform: translateX(0); }\n    90%, 94% { transform: translateX(-5px); }\n    92%, 96% { transform: translateX(5px); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    #cta-inmediato { animation: none; }\n  }\n\n  body:has(._rsi-buy-now-button-product) #cta-inmediato { display: none; }\n</style>\n\n<button type=\"button\" id=\"cta-inmediato\" aria-label=\"Comprar con pago contra entrega\">\n  <svg class=\"cta-icono\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n    <path d=\"M3 6h11v9H3z\"/><path d=\"M14 9h4l3 3v3h-7z\"/>\n    <circle cx=\"7\" cy=\"17.5\" r=\"1.8\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.8\"/>\n  </svg>\n  <span>\n    CLICK AQUI, PAGA EN CASA\n    <span class=\"cta-sub\">¡ENVIO GRATIS!</span>\n  </span>\n</button>\n\n<script>\n(function () {\n  var SELECTOR_REAL = '._rsi-buy-now-button-product';\n  var MS_ESPERA_MAXIMA = 12000;\n  var MS_INTENCION_VALIDA = 15000;\n\n  var placeholder = document.getElementById('cta-inmediato');\n  if (!placeholder) return;\n\n  var contenedor = placeholder.closest('.product-form__buttons') || document;\n  var intencionEn = 0;\n  var resuelto = false;\n\n  function botonReal() {\n    return contenedor.querySelector(SELECTOR_REAL) || document.querySelector(SELECTOR_REAL);\n  }\n\n  function activar(real) {\n    if (resuelto) return;\n    resuelto = true;\n    observador.disconnect();\n    placeholder.style.display = 'none';\n\n    var aTiempo = intencionEn && (Date.now() - intencionEn) < MS_INTENCION_VALIDA;\n    if (aTiempo) real.click();\n  }\n\n  function rendirse() {\n    if (resuelto) return;\n    resuelto = true;\n    observador.disconnect();\n    placeholder.style.display = 'none';\n\n    var nativo = document.querySelector('.product-form__submit');\n    if (nativo) nativo.style.setProperty('display', 'flex', 'important');\n  }\n\n  placeholder.addEventListener('click', function () {\n    var real = botonReal();\n    if (real) { activar(real); return; }\n\n    intencionEn = Date.now();\n    placeholder.setAttribute('data-esperando', '1');\n  });\n\n  var observador = new MutationObserver(function () {\n    var real = botonReal();\n    if (real) activar(real);\n  });\n  observador.observe(document.body, { childList: true, subtree: true });\n\n  var yaEstaba = botonReal();\n  if (yaEstaba) activar(yaEstaba);\n  else setTimeout(rendirse, MS_ESPERA_MAXIMA);\n})();\n</script>\n"
          }
        },
        "funnel": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  PDP FUNNEL-IMAGEN · el cuerpo. Recorre las piezas por alt `pdp-1` … `pdp-25`\n  EN ORDEN NUMÉRICO (no en el orden de la galería, que el usuario reordena a mano)\n  y las pinta a ancho completo sobre un fondo único.\n  Producto nuevo = subir las imágenes con esos alt. Cero edición de plantilla.\n  El CTA se intercala tras la pieza 2 y la 4 — nunca solo al final.\n{%- endcomment -%}\n{%- liquid\n  assign fondo = product.metafields.custom.funnel_fondo | default: '#FFFFFF'\n  assign cta_texto = product.metafields.custom.funnel_cta | default: 'PEDIR AHORA — PAGAS AL RECIBIR'\n  assign piezas = 0\n  assign ultima = 0\n  for im in product.images\n    assign tok = im.alt | default: '' | downcase | split: ' ' | first\n    if tok contains 'pdp-' and tok != 'pdp-hero'\n      assign piezas = piezas | plus: 1\n      assign n = tok | remove: 'pdp-' | times: 1\n      if n > ultima\n        assign ultima = n\n      endif\n    endif\n  endfor\n-%}\n{%- if piezas > 0 -%}\n<div class=\"fi-bleed\" style=\"background:{{ fondo }}\">\n  {%- for i in (1..25) -%}\n    {%- assign clave = 'pdp-' | append: i -%}\n    {%- for im in product.images -%}\n      {%- assign tok = im.alt | default: '' | downcase | split: ' ' | first -%}\n      {%- if tok == clave -%}\n        <img src=\"{{ im | image_url: width: 1200 }}\"\n             srcset=\"{% render 'fi-srcset', imagen: im %}\" sizes=\"100vw\"\n             alt=\"{{ im.alt | escape }}\"\n             width=\"{{ im.width }}\" height=\"{{ im.height }}\" loading=\"lazy\" decoding=\"async\">\n        {%- comment -%}\n          `intercalar`: sin esta guarda, el CTA de la última pieza y el CTA de cierre salen pegados\n          y el cliente ve dos botones de Releasit idénticos, uno encima del otro.\n          Liquid evalúa `or`/`and` de DERECHA A IZQUIERDA y sin paréntesis, así que la condición\n          se arma en una variable en vez de encadenarla en el `if`.\n        {%- endcomment -%}\n        {%- liquid\n          assign intercalar = false\n          if i == 2 or i == 6 or i == 11 or i == 16 or i == 20\n            assign intercalar = true\n          endif\n          if i == ultima\n            assign intercalar = false\n          endif\n        -%}\n        {%- if intercalar -%}\n          <a class=\"fi-cta\" href=\"/rsi-btn-hook\">{{ cta_texto | escape }}<small>Env&iacute;o gratis a toda Colombia</small></a>\n        {%- endif -%}\n      {%- endif -%}\n    {%- endfor -%}\n  {%- endfor -%}\n  <a class=\"fi-cta\" href=\"/rsi-btn-hook\">{{ cta_texto | escape }}<small>Env&iacute;o gratis a toda Colombia</small></a>\n</div>\n{%- endif -%}\n\n{%- comment -%}\n  Guardián: esta plantilla es un CONTENEDOR — sin piezas no muestra nada y la página\n  queda en blanco bajo el botón. El aviso se pinta SOLO en el editor de temas\n  (request.design_mode), nunca para un cliente.\n{%- endcomment -%}\n{%- if piezas == 0 and request.design_mode -%}\n<div style=\"border:2px dashed #c00;background:#fff5f5;padding:16px;margin:20px 0;font-size:1.05rem;color:#1C1C1C;line-height:1.5;\">\n  <strong>Faltan las piezas del funnel.</strong><br>\n  Esta plantilla lee las im&aacute;genes del producto por su <code>alt</code>. Sube las piezas a este\n  producto con alt <code>pdp-hero</code>, <code>pdp-1</code>, <code>pdp-2</code>&hellip; y aparecen\n  ac&aacute; en orden num&eacute;rico. Mientras tanto el cliente ve la p&aacute;gina sin funnel.\n</div>\n{%- endif -%}\n\n{%- comment -%}\n  BOTONES A RAS DE LA PIEZA.\n  Releasit reemplaza cada `<a class=\"fi-cta\">` por su `#_rsi-buy-now-button` y le escribe un\n  atributo `style` INLINE con !important (`border-radius:15px !important`, color, sombra…). Un\n  !important inline gana a cualquier hoja de estilo, así que el radio no se puede quitar por CSS\n  —el margen sí, porque ese no viaja en el inline—. De ahí que esto sea JS y no una regla más.\n\n  Qué se toca y qué no: solo la CAJA (margen y ancho del botón, y el margen del envoltorio que el\n  tema le pone alrededor) y solo dentro de esta plantilla. El radio, el color, el texto, el icono y\n  la animación siguen saliendo de la app, que es donde se configuran. El botón flotante de abajo\n  queda intacto.\n\n  El segundo objetivo es el ENVOLTORIO: el bloque `cta_inmediato` mete el botón dentro de un <div>\n  sin clase que es hijo directo de la ficha, y por eso se lleva el `margin: 1rem 0` del tema. Sin\n  clase a la que apuntar no hay regla CSS que lo alcance (`:has()` serviría, pero no en todos los\n  navegadores que trae el tráfico de Meta), así que se sube por el DOM desde el propio botón.\n{%- endcomment -%}\n<script>\n(function () {\n  var DENTRO = '.fi-bleed ._rsi-buy-now-button, .fi-cierre ._rsi-buy-now-button,' +\n               ' .product__info-container ._rsi-buy-now-button';\n  // El RADIO no está en esta lista a propósito: se configura en la app Releasit, que es su dueña.\n  var GEOMETRIA = [['margin', '0'], ['width', '100%'], ['max-width', '100%']];\n  var obs, trabajando = false;\n\n  function esFlotante(b) {\n    return b.classList.contains('_rsi-buy-now-button-floating') ||\n           !!b.closest('[class*=\"floating\"]');\n  }\n  function fijar(b, prop, val) {\n    // Solo escribe si hace falta: reescribir el mismo valor vuelve a disparar el observador.\n    if (b.style.getPropertyValue(prop) === val && b.style.getPropertyPriority(prop) === 'important') return;\n    b.style.setProperty(prop, val, 'important');\n  }\n  function arasar() {\n    if (trabajando) return;\n    trabajando = true;\n    try {\n      var bs = document.querySelectorAll(DENTRO);\n      for (var i = 0; i < bs.length; i++) {\n        if (esFlotante(bs[i])) continue;\n        for (var j = 0; j < GEOMETRIA.length; j++) fijar(bs[i], GEOMETRIA[j][0], GEOMETRIA[j][1]);\n        // El envoltorio: se sube hasta el hijo directo de la ficha y se le quita el margen.\n        var env = bs[i].parentElement;\n        while (env && env.parentElement &&\n               !env.parentElement.classList.contains('product__info-container')) {\n          env = env.parentElement;\n        }\n        if (env && env.parentElement) {\n          fijar(env, 'margin-top', '0');\n          fijar(env, 'margin-bottom', '0');\n        }\n      }\n    } finally { trabajando = false; }\n  }\n\n  arasar();\n  // Releasit pinta tarde y vuelve a escribir el style cuando el botón cambia de estado.\n  obs = new MutationObserver(arasar);\n  obs.observe(document.body, {childList: true, subtree: true,\n                              attributes: true, attributeFilter: ['style', 'class']});\n})();\n</script>\n"
          }
        }
      },
