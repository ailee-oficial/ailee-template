{%- comment -%}
  Marco común de «Escena» y «Cierre con precio» (kit v2): imagen de dirección de arte y el panel con los
  bloques que la sección ya pintó. La disposición, los colores y el espacio se cambian desde el editor sin
  regenerar la imagen. Parámetros: s (section.settings), panel (HTML de los bloques), sid (section.id),
  tipo ('escena' o 'cierre').
  Fuente canónica: claude-skills/core/tema_landing.
{%- endcomment -%}
{%- assign diferir = false -%}
{%- if s.prioridad -%}
  {%- assign carga = 'eager' -%}
  {%- assign prioridad = 'high' -%}
{%- else -%}
  {%- assign carga = 'lazy' -%}
  {%- assign prioridad = 'auto' -%}
  {%- if s.diferir -%}{%- assign diferir = true -%}{%- endif -%}
{%- endif -%}
<div class="bm-sec bm-escena-sec bm-v2{% if s.ancho == 'completo' %} bm-sec--completo{% endif %}" data-bm-landing="{{ tipo }}" data-bm-sec="{{ sid }}" style="{% if s.fondo != blank %}--bm-sec-bg:{{ s.fondo }};{% endif %}{% if s.texto != blank %}--bm-sec-fg:{{ s.texto }};{% endif %}{% if s.panel_fondo != blank %}--bm-panel-bg:{{ s.panel_fondo }};{% endif %}{% if s.acento != blank %}--bm-acento:{{ s.acento }};{% endif %}{% if s.acento_texto != blank %}--bm-acento-fg:{{ s.acento_texto }};{% endif %}--bm-pad-top:{{ s.padding_top }}px;--bm-pad-bottom:{{ s.padding_bottom }}px;--bm-panel-pad:{{ s.panel_padding }}px;--bm-panel-gap:{{ s.separacion }}px;--bm-align:{{ s.alineacion }};--bm-precio-align:{% if s.alineacion == 'center' %}center{% elsif s.alineacion == 'right' %}flex-end{% else %}flex-start{% endif %};--bm-panel-v:{{ s.posicion_texto }};{% unless s.sobre_degradado %}--bm-panel-sobre:transparent;{% endunless %}">
  <div class="bm-sec__in">
    <div class="bm-escena bm-escena--{{ s.disposicion }}">
      {%- if s.titulo_oculto != blank -%}
        {%- if s.nivel_oculto == 'h1' -%}
          <h1 class="bm-sr">{{ s.titulo_oculto | escape }}</h1>
        {%- else -%}
          <h2 class="bm-sr">{{ s.titulo_oculto | escape }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if s.imagen != blank and s.disposicion != 'solo_texto' -%}
        <div class="bm-escena__media"{% if diferir %} data-bm-diferido{% endif %}>
          {%- capture foto -%}
          <picture>
            {%- if s.imagen_escritorio != blank -%}
              <source media="(min-width: 750px)" srcset="{{ s.imagen_escritorio | image_url: width: 1600 }}">
            {%- endif -%}
            {{ s.imagen | image_url: width: 1600 | image_tag: loading: carga, fetchpriority: prioridad, sizes: '(min-width: 750px) 780px, 100vw', widths: '360, 540, 720, 900, 1080, 1280, 1600', alt: s.texto_alt }}
          </picture>
          {%- endcapture -%}
          {%- if diferir -%}
            {{ foto | replace: ' srcset="', ' data-bm-srcset="' | replace: ' src="', ' data-bm-src="' }}
          {%- else -%}
            {{ foto }}
          {%- endif -%}
        </div>
      {%- elsif request.design_mode and s.disposicion != 'solo_texto' -%}
        <div class="bm-escena__media">{{ 'image' | placeholder_svg_tag: 'bm-placeholder' }}</div>
      {%- endif -%}
      {%- if panel != blank -%}
        <div class="bm-escena__panel">{{ panel }}</div>
      {%- endif -%}
    </div>
  </div>
  {%- if diferir -%}{%- render 'bm-diferir' -%}{%- endif -%}
</div>
