{%- comment -%}FESTIVOS-COLOMBIA:fin{%- endcomment -%}
{%- liquid
  assign contar_hoy = true
  assign hab_min = dias_min | default: 3
  assign hab_max = dias_max | default: 5

  assign t = ahora | default: 'now' | date: '%s' | plus: 0
  unless contar_hoy
    assign t = t | plus: 86400
  endunless

  comment
    Se recorre día a día (máx. 30) hasta el día hábil `hab_max`; en el `hab_min`-ésimo se anota el
    primer día de la ventana. `t` es un instante en segundos: sumar 86400 es pasar al día siguiente
    porque Colombia no cambia de hora. `clave` = ',AAAA-MM-DD,' se busca en la lista con `contains`.
  endcomment
  assign n = 0
  assign ini = 0
  assign fin = 0
  for i in (1..30)
    assign w = t | date: '%w' | plus: 0
    assign clave = t | date: ',%Y-%m-%d,'
    assign habil = true
    if w == 0
      assign habil = false
    endif
    if festivos contains clave
      assign habil = false
    endif
    if habil
      assign n = n | plus: 1
      if n == hab_min
        assign ini = t
      endif
      if n == hab_max
        assign fin = t
        break
      endif
    endif
    assign t = t | plus: 86400
  endfor

  assign meses_abrev = 'ene.,feb.,mar.,abr.,may.,jun.,jul.,ago.,sep.,oct.,nov.,dic.' | split: ','
  assign dias_abrev = 'dom.,lun.,mar.,mié.,jue.,vie.,sáb.' | split: ','
  assign d1 = ini | date: '%-d'
  assign d2 = fin | date: '%-d'
  assign w1 = ini | date: '%w' | plus: 0
  assign w2 = fin | date: '%w' | plus: 0
  comment
    `m1`/`m2` en vez de un solo mes: cuando la ventana cruza de mes —hoy 28 y entrega 30 y 2— tomar
    el mes de la fecha FINAL fecharía mal la primera.
  endcomment
  assign m1 = ini | date: '%-m' | minus: 1
  assign m2 = fin | date: '%-m' | minus: 1

  comment
    La salida se arma con `echo` dentro de este bloque, no con texto suelto entre `when`: los espacios
    entre una variable y un `when` con guion dejaban un salto de línea colado en dos de las tres ramas
    (medido en la tienda real, 2026-09-18). Así la frase sale exacta, sin nada antes ni después.
  endcomment
  if fin == 0
    comment
      Imposible con 30 días de margen; si pasara, la frase sigue siendo cierta.
    endcomment
    if formato == 'rango'
      echo hab_min | append: '&ndash;' | append: hab_max | append: ' días hábiles'
    else
      echo hab_min | append: ' y ' | append: hab_max | append: ' días hábiles'
    endif
  else
    assign texto_ini = dias_abrev[w1] | append: ' ' | append: d1
    assign texto_fin = dias_abrev[w2] | append: ' ' | append: d2 | append: ' de ' | append: meses_abrev[m2]
    if m1 != m2
      assign texto_ini = texto_ini | append: ' de ' | append: meses_abrev[m1]
    endif
    case formato
      when 'entre'
        echo texto_ini | append: ' y ' | append: texto_fin
      when 'entre_b'
        echo '<b>' | append: texto_ini | append: '</b> y <b>' | append: texto_fin | append: '</b>'
      else
        assign rango_ini = d1
        if m1 != m2
          assign rango_ini = d1 | append: ' ' | append: meses_abrev[m1]
        endif
        echo rango_ini | append: '&ndash;' | append: d2 | append: ' ' | append: meses_abrev[m2]
    endcase
  endif
-%}
