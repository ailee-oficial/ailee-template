{%- comment -%}
  ah-confianza — franja de confianza de la ficha boutique (íconos en fila, como el diseño).
  Las líneas NO van fijas aquí: cada plantilla las pasa, porque lo que se puede prometer cambia
  por producto (p. ej. sueco-045 no promete garantía ni cambios: estrategia.json → garantia).

  Parámetros:
    items    'icono|Título|texto;icono|Título|texto' (iconos de ah-icono)
    whatsapp número con indicativo, sin espacios (vacío = sin fila de WhatsApp)
    mensaje  texto que se escribe solo en WhatsApp
{%- endcomment -%}
{%- assign ahc_items = items | split: ';' -%}
{%- assign ahc_numero = whatsapp | strip | remove: ' ' | remove: '+' -%}
<div class="ahc">
  {%- for it in ahc_items -%}
    {%- assign p = it | split: '|' -%}
    {%- if p.size > 1 -%}
      <div class="ahc__fila">
        {%- render 'ah-icono', icono: p[0] -%}
        <div><p class="ahc__titulo">{{ p[1] | strip | escape }}</p>{%- if p[2] != blank -%}<p class="ahc__texto">{{ p[2] | strip | escape }}</p>{%- endif -%}</div>
      </div>
    {%- endif -%}
  {%- endfor -%}
  {%- if ahc_numero != blank -%}
    <a class="ahc__fila ahc__wa" href="https://wa.me/{{ ahc_numero }}?text={{ mensaje | default: 'Hola Ailée, tengo una pregunta sobre este producto.' | append: ' ' | append: product.title | url_encode }}" target="_blank" rel="noopener">
      {%- render 'ah-icono', icono: 'whatsapp' -%}
      <div><p class="ahc__titulo">¿Tienes dudas?</p><p class="ahc__texto">Te asesoramos por WhatsApp</p></div>
      <span class="ahc__flecha">{%- render 'ah-icono', icono: 'flecha-der' -%}</span>
    </a>
  {%- endif -%}
</div>
<style>
  .ahc { margin: 16px 0 4px; background: #f3ede7; border-radius: 14px; padding: 16px 8px; font-family: 'DM Sans', 'Helvetica Neue', Arial, sans-serif; color: #1c1c1c;
         display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
  .ahc__fila { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 2px 8px; text-decoration: none; color: inherit; }
  .ahc__fila + .ahc__fila { border-left: 1px solid #e2d8cc; }
  .ahc__fila > svg { width: 28px; height: 28px; flex: none; }
  .ahc__titulo { margin: 0; font-size: 13px !important; font-weight: 500; line-height: 1.25; }
  .ahc__texto { margin: 0; font-size: 12px !important; color: #6b6560; line-height: 1.3; }
  .ahc__wa { cursor: pointer; }
  .ahc__flecha { display: none; }
</style>
