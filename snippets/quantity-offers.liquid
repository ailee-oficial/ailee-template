{%- comment -%}
  Widget de ofertas por cantidad, configurable desde el editor de temas y
  sincronizado con el formulario COD de Releasit.
  Uso: {% render 'quantity-offers', block: block, product: product %}
  Las ofertas (1-3) se configuran en block.settings (offer_N_*).
  Los selectores de talla/color se generan dinámicamente desde el producto.
{%- endcomment -%}

{%- liquid
  assign options = product.options_with_values
  assign sel_border = block.settings.selected_border | default: '#0f172a'
  assign has_variants = true
  if product.has_only_default_variant
    assign has_variants = false
  endif

  comment
    Determinar qué oferta queda seleccionada por defecto.
    Si la oferta elegida está desactivada, cae a la primera activa.
  endcomment
  assign default_slot = block.settings.default_offer | default: 2 | plus: 0
  assign default_key = 'offer_' | append: default_slot | append: '_enabled'
  assign selected_slot = 0
  if block.settings[default_key]
    assign selected_slot = default_slot
  else
    for s in (1..3)
      assign s_key = 'offer_' | append: s | append: '_enabled'
      if block.settings[s_key]
        assign selected_slot = s
        break
      endif
    endfor
  endif

  comment
    Índice (entre las ofertas ACTIVAS) de la oferta seleccionada por defecto.
  endcomment
  assign default_index = 0
  assign ri = 0
  for s in (1..3)
    assign s_key = 'offer_' | append: s | append: '_enabled'
    if block.settings[s_key]
      if s == selected_slot
        assign default_index = ri
      endif
      assign ri = ri | plus: 1
    endif
  endfor
-%}

<div id="qo-widget" class="qo-widget" style="--qo-sel-border: {{ sel_border }};" data-default-index="{{ default_index }}" {{ block.shopify_attributes }}>
  <div class="qo-head"><span class="qo-head__t">Elige tu oferta</span></div>
  <div class="qo-list">
    {%- assign render_index = 0 -%}
    {%- for i in (1..3) -%}
      {%- assign k_en = 'offer_' | append: i | append: '_enabled' -%}
      {%- unless block.settings[k_en] -%}{%- continue -%}{%- endunless -%}

      {%- assign k_title    = 'offer_' | append: i | append: '_title' -%}
      {%- assign k_badge    = 'offer_' | append: i | append: '_badge' -%}
      {%- assign k_bg       = 'offer_' | append: i | append: '_badge_bg' -%}
      {%- assign k_qty      = 'offer_' | append: i | append: '_qty' -%}
      {%- assign k_pay      = 'offer_' | append: i | append: '_pay' -%}
      {%- assign k_pct      = 'offer_' | append: i | append: '_pct' -%}
      {%- assign k_cmp      = 'offer_' | append: i | append: '_compare' -%}
      {%- assign k_discount = 'offer_' | append: i | append: '_discount' -%}

      {%- assign of_title    = block.settings[k_title] -%}
      {%- assign of_badge    = block.settings[k_badge] -%}
      {%- assign of_bg       = block.settings[k_bg] -%}
      {%- assign of_qty      = block.settings[k_qty] | default: 1 -%}
      {%- assign of_pay      = block.settings[k_pay] | default: 0 -%}
      {%- assign of_pct      = block.settings[k_pct] | default: 0 -%}
      {%- assign of_cmp      = block.settings[k_cmp] | default: 0 -%}

      {%- comment -%} Precio dinámico (escala a cualquier producto): 1) "paga N" → precio = precio × pay; 2) "% dinámico" → precio = precio × qty × (100-pct)/100; 3) si ambos = 0, descuento fijo COP. Tachado siempre = precio × qty. {%- endcomment -%}
      {%- if of_pay > 0 -%}
        {%- assign of_price   = product.price | times: of_pay -%}
        {%- assign of_cmp_cts = product.price | times: of_qty -%}
      {%- elsif of_pct > 0 -%}
        {%- assign of_base    = product.price | times: of_qty -%}
        {%- assign of_keep    = 100 | minus: of_pct -%}
        {%- assign of_price   = of_base | times: of_keep | divided_by: 100 -%}
        {%- assign of_cmp_cts = of_base -%}
      {%- else -%}
        {%- assign of_discount = block.settings[k_discount] | default: 0 | times: 100 -%}
        {%- assign of_price    = product.price | times: of_qty | minus: of_discount -%}
        {%- assign of_cmp_cts  = of_cmp | times: 100 -%}
      {%- endif -%}
      {%- if of_price < 0 -%}{%- assign of_price = 0 -%}{%- endif -%}

      {%- assign is_selected = false -%}
      {%- if i == selected_slot -%}{%- assign is_selected = true -%}{%- endif -%}

      <div class="qo-card {% if is_selected %}qo-card--selected{% endif %}{% if i == selected_slot %} qo-card--featured{% endif %}"
           data-offer-index="{{ render_index }}"
           data-offer-qty="{{ of_qty }}">

        <div class="qo-card__header">
          <div class="qo-card__info">
            <div class="qo-card__title">{{ of_title }}</div>
            {%- if of_badge != blank -%}
              <div class="qo-card__badge" style="background: {{ of_bg }};">{{ of_badge }}</div>
            {%- endif -%}
          </div>
          <div class="qo-card__prices">
            {%- if of_cmp_cts > of_price -%}
              <p class="qo-price-original">{{ of_cmp_cts | money_without_trailing_zeros }}</p>
            {%- endif -%}
            <p class="qo-price-sale">{{ of_price | money_without_trailing_zeros }}</p>
          </div>
        </div>

        {%- unless has_variants == false -%}
        <div class="qo-card__variants {% unless is_selected %}qo-card__variants--hidden{% endunless %}">
          {%- for n in (1..of_qty) -%}
            <div class="qo-variant-row">
              <span class="qo-variant-index">#{{ n }}</span>
              <div class="qo-variant-selects">
                {%- for option in options -%}
                  <div class="qo-variant-col">
                    {%- if n == 1 -%}
                      <small class="qo-option-label">{{ option.name }}</small>
                    {%- else -%}
                      <small class="qo-option-label qo-option-label--hidden">{{ option.name }}</small>
                    {%- endif -%}
                    <select class="qo-select"
                            data-item="{{ n | minus: 1 }}"
                            data-option-index="{{ forloop.index0 }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}">{{ value }}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- endunless -%}

      </div>
      {%- assign render_index = render_index | plus: 1 -%}
    {%- endfor -%}
  </div>
</div>

<style>
.qo-widget {
  font-family: var(--font-body-family, -apple-system, sans-serif);
  margin: 16px 0;
}
.qo-head { display: flex; align-items: center; gap: 10px; margin: 2px 0 12px; }
.qo-head__t { font-size: 19px; font-weight: 800; color: #111; letter-spacing: -.01em; }
.qo-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.qo-card {
  position: relative;
  border: 2px solid var(--cm-blush, #E8D5C8);
  border-radius: 14px;
  background: #fff;
  padding: 15px 16px 15px 46px;
  cursor: pointer;
  transition: border-color .15s, background .15s, box-shadow .15s;
}
.qo-card::before {
  content: '';
  position: absolute;
  left: 16px;
  top: 17px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid var(--cm-beige, #D9C4B5);
  background: #fff;
  transition: .15s;
}
.qo-card--selected {
  border-color: #E11D2A;
  background: #FDECEC;
}
.qo-card--selected::before {
  border-color: #E11D2A;
  background: radial-gradient(#E11D2A 0 42%, #fff 46%);
}
.qo-card--featured::after {
  content: '★ MÁS ELEGIDO';
  position: absolute;
  top: -11px;
  right: 14px;
  background: #E11D2A;
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .03em;
  padding: 3px 10px;
  border-radius: 100px;
  white-space: nowrap;
}
.qo-card__header {
  display: flex;
  align-items: center;
  gap: 8px;
}
.qo-card__info {
  flex: 1;
  min-width: 0;
}
.qo-card__title {
  font-size: 16px;
  font-weight: 800;
  color: #111;
  margin-bottom: 3px;
  letter-spacing: -.01em;
}
.qo-card__badge {
  display: inline-block;
  background: none !important;
  color: var(--cm-text-muted, #7A7A7A) !important;
  padding: 0 !important;
  border-radius: 0 !important;
  font-size: 12px;
  font-weight: 600;
}
.qo-card__prices {
  text-align: right;
  white-space: nowrap;
}
.qo-price-original {
  margin: 0;
  text-decoration: line-through;
  color: #9A9A9A;
  font-size: 13px;
}
.qo-price-sale {
  margin: 0;
  font-size: 20px;
  font-weight: 800;
  color: #111;
}
.qo-card__variants { margin-top: 12px; }
.qo-card__variants--hidden { display: none; }
.qo-variant-row {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  margin-bottom: 4px;
}
.qo-variant-index {
  font-weight: 700;
  font-size: 14px;
  padding-bottom: 10px;
  flex-shrink: 0;
  min-width: 20px;
}
.qo-variant-selects {
  display: flex;
  gap: 8px;
  flex: 1;
}
.qo-variant-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.qo-option-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 2px;
}
.qo-option-label--hidden { visibility: hidden; }
.qo-select {
  width: 100%;
  padding: 6px 4px;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fff;
  font-size: 13px;
}
</style>

<script>
(function() {
  var widget = document.getElementById('qo-widget');
  if (!widget) return;

  var selectedIndex = parseInt(widget.dataset.defaultIndex, 10) || 0;

  widget.querySelectorAll('.qo-card').forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.tagName === 'SELECT') return;
      selectOffer(parseInt(card.dataset.offerIndex));
    });
  });

  function selectOffer(idx) {
    selectedIndex = idx;
    widget.querySelectorAll('.qo-card').forEach(function(c) {
      var i = parseInt(c.dataset.offerIndex);
      c.classList.toggle('qo-card--selected', i === idx);
      var v = c.querySelector('.qo-card__variants');
      if (v) v.classList.toggle('qo-card__variants--hidden', i !== idx);
    });
    if (rsiModalOpen()) { hideOffers(); syncToRsi(idx, showOffers); }
  }

  // ── Helpers Releasit ──
  function rsiOffers() { return document.querySelectorAll('._rsi-quantity-offers-offer-container'); }
  function rsiModalOpen() {
    var m = document.getElementById('_rsi-cod-form-modal');
    return !!(m && m.className.indexOf('_rsi-cod-form-modal-open') !== -1);
  }
  function rsiSelect(idx) {
    var items = rsiOffers();
    if (!items[idx]) return;
    var inner = items[idx].querySelector('._rsi-quantity-offers-offer') || items[idx];
    inner.click();
    ['mousedown','mouseup','click'].forEach(function(t) {
      items[idx].dispatchEvent(new MouseEvent(t, { bubbles: true, cancelable: true, view: window }));
    });
  }
  function rsiIsSelected(idx) {
    var items = rsiOffers();
    return !!(items[idx] && items[idx].className.indexOf('selected') !== -1);
  }

  // ── Mapeo por CANTIDAD, no por posición ──
  // El widget puede mostrar un SUBCONJUNTO de las ofertas de Releasit (ej. 2 y 3 pares),
  // mientras Releasit tiene 1, 2 y 3. Sincronizar por índice corre todo "por uno".
  // Por eso ubicamos la oferta de Releasit cuya CANTIDAD coincide con la de la card del widget.
  function rsiOfferQty(el) {
    if (!el) return 0;
    // 1) por texto: "2 pares", "1 par" (lo más fiable para ofertas no seleccionadas)
    var m = (el.textContent || '').match(/(\d+)\s*par/i);
    if (m) return parseInt(m[1], 10);
    // 2) fallback: mayor número de ítem entre sus selectores de variante = cantidad
    var max = 0;
    el.querySelectorAll('select[data-offer-num-multi-sel]').forEach(function(s){
      var n = parseInt(s.getAttribute('data-offer-num-multi-sel'), 10); if (n > max) max = n;
    });
    if (max === 0) el.querySelectorAll('select[data-offer-num]').forEach(function(s){
      var n = parseInt(s.getAttribute('data-offer-num'), 10); if (n > max) max = n;
    });
    return max;
  }
  function rsiIdxForQty(qty) {
    var items = rsiOffers();
    for (var i = 0; i < items.length; i++) { if (rsiOfferQty(items[i]) === qty) return i; }
    return -1;
  }
  function widgetQty(widgetIdx) {
    var card = widget.querySelectorAll('.qo-card')[widgetIdx];
    return card ? parseInt(card.dataset.offerQty, 10) : 0;
  }
  // Devuelve el índice de Releasit que corresponde a la card del widget.
  // 1) por cantidad (lo correcto). 2) fallback por DESPLAZAMIENTO: el widget muestra la "cola"
  //    de las ofertas de Releasit, así que offset = (total Releasit − total widget) y
  //    índice Releasit = índice widget + offset. Esto cubre cuando una oferta de Releasit
  //    no es identificable por texto/selectores (ej. "3 pares" no seleccionada aún).
  function rsiIdxForWidget(widgetIdx) {
    var byQty = rsiIdxForQty(widgetQty(widgetIdx));
    if (byQty >= 0) return byQty;
    var total = rsiOffers().length;
    var cards = widget.querySelectorAll('.qo-card').length;
    if (total > 0 && total >= cards) return widgetIdx + (total - cards);
    return -1;
  }

  // Hoja de estilos inyectada: ocultar las cards de Releasit durante la sync (sin flash).
  var syncSheet = (function() {
    var s = document.createElement('style');
    s.textContent = '._rsi-quantity-offers-offer-container{visibility:hidden!important}';
    s.disabled = true;
    document.head.appendChild(s);
    return s;
  })();
  function hideOffers() { syncSheet.disabled = false; }
  function showOffers() { syncSheet.disabled = true; }

  // Ubica la oferta Releasit con la MISMA cantidad que la card del widget, la selecciona y
  // sincroniza las variantes. Reintenta hasta que Releasit pinte sus ofertas/selectores.
  function syncToRsi(widgetIdx, onDone) {
    var start = Date.now();
    var iv = setInterval(function() {
      var r = rsiIdxForWidget(widgetIdx);
      if (r >= 0) {
        if (!rsiIsSelected(r)) rsiSelect(r);
        var offer = rsiOffers()[r];
        var sels = offer ? offer.querySelectorAll('select[data-offer-num-multi-sel], select[data-offer-num]') : [];
        if (rsiIsSelected(r) && sels.length > 0) {
          syncVariants(widgetIdx, r);
          clearInterval(iv); if (onDone) onDone(); return;
        }
      }
      if (Date.now() - start > 3000) { clearInterval(iv); if (onDone) onDone(); }
    }, 60);
  }

  // ── Detección de apertura del modal ──
  var wasOpen = false;
  function onModalOpen() {
    if (wasOpen) return;
    wasOpen = true;
    hideOffers(); // ocultar ANTES del primer paint
    syncToRsi(selectedIndex, showOffers);
  }
  function onModalClose() {
    wasOpen = false;
    showOffers();
  }

  function attachObserver(modal) {
    var obs = new MutationObserver(function(mutations) {
      var open = modal.className.indexOf('_rsi-cod-form-modal-open') !== -1;
      if (open) onModalOpen(); else onModalClose();
    });
    obs.observe(modal, { attributes: true, attributeFilter: ['class'] });
  }

  var modal = document.getElementById('_rsi-cod-form-modal');
  if (modal) {
    attachObserver(modal);
  } else {
    var pollModal = setInterval(function() {
      var m = document.getElementById('_rsi-cod-form-modal');
      if (m) { attachObserver(m); clearInterval(pollModal); }
    }, 300);
  }

  setInterval(function() {
    var open = rsiModalOpen();
    if (open && !wasOpen) onModalOpen();
    else if (!open && wasOpen) onModalClose();
  }, 200);

  // ── Sync de variantes (talla/color) ──
  function applyVariant(card, rs, item, opt) {
    var ws = card.querySelector('.qo-select[data-item="' + item + '"][data-option-index="' + opt + '"]');
    if (!ws) return;
    var want = ws.options[ws.selectedIndex].textContent.trim().toUpperCase();
    for (var i = 0; i < rs.options.length; i++) {
      if (rs.options[i].textContent.trim().toUpperCase() === want) {
        if (rs.selectedIndex !== i) {
          rs.selectedIndex = i;
          rs.dispatchEvent(new Event('input', { bubbles: true }));
          rs.dispatchEvent(new Event('change', { bubbles: true }));
        }
        break;
      }
    }
  }
  function syncVariants(widgetIdx, rsiIdx) {
    var card = widget.querySelectorAll('.qo-card')[widgetIdx];
    var offer = rsiOffers()[rsiIdx];
    if (!card || !offer) return;
    var multi = offer.querySelectorAll('select[data-offer-num-multi-sel]');
    if (multi.length > 0) {
      multi.forEach(function(rs) {
        applyVariant(card, rs,
          parseInt(rs.getAttribute('data-offer-num-multi-sel'), 10) - 1,
          parseInt(rs.getAttribute('data-option-num'), 10));
      });
    } else {
      offer.querySelectorAll('select[data-offer-num]').forEach(function(rs) {
        applyVariant(card, rs, parseInt(rs.getAttribute('data-offer-num'), 10) - 1, 0);
      });
    }
  }

  widget.querySelectorAll('.qo-select').forEach(function(s) {
    s.addEventListener('change', function() {
      if (rsiModalOpen()) syncToRsi(selectedIndex);
    });
  });

  window.qoSelectedOffer = function() { return selectedIndex; };
})();
</script>
