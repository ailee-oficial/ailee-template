{%- comment -%}
  Widget de ofertas por cantidad — sincronizado con Releasit COD Form.
  Uso: {% render 'quantity-offers', product: product %}

  Estructura de offers esperada (Liquid array):
    offers = [{
      title, badge_text, badge_gradient,
      qty, original_price, sale_price,
      popular: true/false
    }, ...]
{%- endcomment -%}

{%- liquid
  assign product_image = product.featured_image | image_url: width: 120
  assign options = product.options_with_values
  assign _offers_raw = "PAGA 1 LLEVA 2^^AHORRA MAS 💸^^linear-gradient(270deg,#F1E408 0%,#0AD64A 100%)^^2^^13000000^^10990000^^false|PAGA 2 LLEVA 3^^MAS VENDIDO 🔥^^linear-gradient(0deg,#23AEFE 0%,#083EFF 97%)^^3^^19500000^^12990000^^true|PAGA 4 LLEVA 5^^MEGA OFERTA 🚀^^linear-gradient(90deg,#FC361C 0%,#FAD20C 100%)^^5^^32500000^^16990000^^false" | split: '|'
-%}

<div id="qo-widget" class="qo-widget">
  <div class="qo-list">

    {%- for offer_str in _offers_raw -%}
      {%- assign of = offer_str | split: '^^' -%}
      {%- assign of_index = forloop.index0 -%}
      {%- assign of_title = of[0] -%}
      {%- assign of_badge = of[1] -%}
      {%- assign of_gradient = of[2] -%}
      {%- assign of_qty = of[3] | plus: 0 -%}
      {%- assign of_original = of[4] | plus: 0 -%}
      {%- assign of_sale = of[5] | plus: 0 -%}
      {%- assign of_popular = of[6] -%}

      {%- assign is_selected = false -%}
      {%- if forloop.first -%}{%- assign is_selected = true -%}{%- endif -%}

      <div class="qo-card {% if is_selected %}qo-card--selected{% endif %}"
           data-offer-index="{{ of_index }}"
           data-offer-qty="{{ of_qty }}"
           data-offer-price="{{ of_sale }}"
           data-offer-original="{{ of_original }}">

        <div class="qo-card__header">
          <div class="qo-card__img">
            <img src="{{ product_image }}" alt="{{ product.title | escape }}" width="55" height="55" loading="lazy">
          </div>
          <div class="qo-card__info">
            <div class="qo-card__title">{{ of_title }}</div>
            <div class="qo-card__badge" style="background: {{ of_gradient }};">{{ of_badge }}</div>
          </div>
          <div class="qo-card__prices">
            <p class="qo-price-original">{{ of_original | money_without_trailing_zeros }}</p>
            <p class="qo-price-sale">{{ of_sale | money_without_trailing_zeros }}</p>
          </div>
        </div>

        <div class="qo-card__variants {% unless is_selected %}qo-card__variants--hidden{% endunless %}">
          {%- for i in (1..of_qty) -%}
            <div class="qo-variant-row">
              <span class="qo-variant-index">#{{ i }}</span>
              <div class="qo-variant-selects">
                {%- for option in options -%}
                  <div class="qo-variant-col">
                    {%- if forloop.first -%}
                      <small class="qo-option-label">{{ option.name }}</small>
                    {%- else -%}
                      <small class="qo-option-label qo-option-label--hidden">{{ option.name }}</small>
                    {%- endif -%}
                    <select class="qo-select"
                            data-item="{{ i | minus: 1 }}"
                            data-option-index="{{ forloop.index0 }}"
                            data-option-name="{{ option.name | downcase }}">
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}">{{ value }}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

      </div>
    {%- endfor -%}

  </div>

  <button id="qo-buy-btn" class="qo-buy-btn" type="button">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
      <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
    </svg>
    <div>
      <span class="qo-buy-btn__title">COMPRAR Y PAGAR AL RECIBIR</span>
      <div class="qo-buy-btn__sub">Envíos a toda Colombia</div>
    </div>
  </button>

</div>

<style>
.qo-widget {
  font-family: var(--font-body-family, -apple-system, sans-serif);
  margin: 16px 0;
}

.qo-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

/* Card */
.qo-card {
  border: 2px solid #d1d1d1;
  border-radius: 8px;
  background: #fff;
  padding: 12px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}
.qo-card--selected {
  border-color: #0f172a;
  background: #f1f4f6;
}

.qo-card__header {
  display: flex;
  align-items: center;
  gap: 8px;
}
.qo-card__img img {
  width: 55px;
  height: 55px;
  object-fit: cover;
  border-radius: 4px;
  flex-shrink: 0;
}
.qo-card__info {
  flex: 1;
  min-width: 0;
}
.qo-card__title {
  font-size: 16px;
  font-weight: 800;
  color: #000;
  margin-bottom: 4px;
}
.qo-card__badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  color: #fff;
}
.qo-card__prices {
  text-align: right;
  white-space: nowrap;
}
.qo-price-original {
  margin: 0;
  text-decoration: line-through;
  color: #888;
  font-size: 13px;
}
.qo-price-sale {
  margin: 0;
  font-size: 18px;
  font-weight: 800;
  color: #000;
}

/* Variant rows */
.qo-card__variants { margin-top: 12px; }
.qo-card__variants--hidden { display: none; }

.qo-variant-row {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  margin-bottom: 4px;
}
.qo-variant-index {
  font-weight: 700;
  font-size: 14px;
  padding-bottom: 10px;
  flex-shrink: 0;
  min-width: 20px;
}
.qo-variant-selects {
  display: flex;
  gap: 8px;
  flex: 1;
}
.qo-variant-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.qo-option-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 2px;
}
.qo-option-label--hidden { visibility: hidden; }

.qo-select {
  width: 100%;
  padding: 6px 4px;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fff;
  font-size: 13px;
  -webkit-appearance: auto;
}

/* Buy button */
.qo-buy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 14px 20px;
  background: #36EA09;
  color: #050000;
  font-size: 19px;
  font-weight: 700;
  border: 2px solid #fff;
  border-radius: 14px;
  box-shadow: 0 2px 7px rgba(0,0,0,0.74);
  cursor: pointer;
  text-align: center;
  animation: qo-pulse 2s infinite;
}
.qo-buy-btn__title { display: block; }
.qo-buy-btn__sub { font-size: 13px; font-weight: 400; }

@keyframes qo-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 2px 7px rgba(0,0,0,0.74); }
  50% { transform: scale(1.02); box-shadow: 0 4px 14px rgba(54,234,9,0.5); }
}
</style>

<script>
(function() {
  var widget = document.getElementById('qo-widget');
  if (!widget) return;

  var selectedIndex = 0;

  /* ── Selección de card ── */
  widget.querySelectorAll('.qo-card').forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.tagName === 'SELECT') return; // no colapsar al cambiar variante
      var idx = parseInt(card.dataset.offerIndex);
      selectOffer(idx);
    });
  });

  function selectOffer(idx) {
    selectedIndex = idx;
    widget.querySelectorAll('.qo-card').forEach(function(c) {
      var i = parseInt(c.dataset.offerIndex);
      c.classList.toggle('qo-card--selected', i === idx);
      var variants = c.querySelector('.qo-card__variants');
      if (variants) variants.classList.toggle('qo-card__variants--hidden', i !== idx);
    });
    // Intentar sincronizar con Releasit si ya está en el DOM
    syncReleasit(idx);
  }

  /* ── Botón de compra ── */
  var buyBtn = document.getElementById('qo-buy-btn');
  buyBtn.addEventListener('click', function() {
    // 1. Intentar clic directo en botón de Releasit
    var rcbBtn = findReleasitButton();
    if (rcbBtn) {
      syncReleasit(selectedIndex);
      rcbBtn.click();
    } else {
      // Fallback: scroll al formulario de Releasit si existe
      var rcbForm = document.querySelector('[data-rcb-form], #rcb-form, .rcb-wrapper, [class*="releasit"], [id*="releasit"]');
      if (rcbForm) {
        rcbForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  });

  function findReleasitButton() {
    var selectors = [
      '[data-rcb-button]',
      '.rcb-button',
      '#rcb-btn',
      '[id*="rcb"][id*="btn"]',
      '[class*="rcb"][class*="btn"]',
      '[data-releasit-btn]',
      '.releasit-btn',
      '#releasit-button'
    ];
    for (var i = 0; i < selectors.length; i++) {
      var el = document.querySelector(selectors[i]);
      if (el) return el;
    }
    return null;
  }

  /* ── Sincronización con Releasit ── */
  function syncReleasit(offerIdx) {
    // Estrategia 1: Releasit expone API global
    if (window.Releasit && typeof window.Releasit.selectOffer === 'function') {
      window.Releasit.selectOffer(offerIdx);
      return;
    }
    if (window.rcb && typeof window.rcb.setOffer === 'function') {
      window.rcb.setOffer(offerIdx);
      return;
    }

    // Estrategia 2: click en el N-ésimo elemento de oferta en el DOM de Releasit
    var offerItems = document.querySelectorAll(
      '.rcb-qo-item, .rcb-offer-item, .rcb-quantity-offer, ' +
      '[class*="rcb"][class*="offer"], [class*="releasit"][class*="offer"], ' +
      '[data-offer-index], [data-rcb-offer]'
    );
    if (offerItems.length > offerIdx) {
      offerItems[offerIdx].click();
    }
  }

  /* ── Observer: cuando Releasit abra su modal, sincronizar ── */
  var observer = new MutationObserver(function() {
    var items = document.querySelectorAll(
      '.rcb-qo-item, .rcb-offer-item, .rcb-quantity-offer, ' +
      '[class*="rcb"][class*="offer"]'
    );
    if (items.length > 0) {
      syncReleasit(selectedIndex);
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  // Guardar selección en variable global accesible por Releasit/otros scripts
  Object.defineProperty(window, 'qoSelectedOffer', {
    get: function() { return selectedIndex; },
    configurable: true
  });

})();
</script>
